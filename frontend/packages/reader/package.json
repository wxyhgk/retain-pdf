{
  "name": "@retainpdf/reader",
  "version": "0.1.0",
  "private": false,
  "description": "RetainPDF reader — standalone react-pdf engine (extracted from frontend/web)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./boot": {
      "types": "./dist/boot.d.ts",
      "import": "./dist/boot.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts.js"
    },
    "./runtime/config": {
      "types": "./dist/runtime/config.d.ts",
      "import": "./dist/runtime/config.js"
    },
    "./runtime/content": {
      "types": "./dist/runtime/content.d.ts",
      "import": "./dist/runtime/content.js"
    },
    "./runtime/data": {
      "types": "./dist/runtime/data.d.ts",
      "import": "./dist/runtime/data.js"
    },
    "./runtime/state": {
      "types": "./dist/runtime/state.d.ts",
      "import": "./dist/runtime/state.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && npm run build:styles",
    "build:styles": "tailwindcss -i ./scripts/styles.css -o ./dist/styles.css --minify && node ./scripts/flatten-css-layers.mjs ./dist/styles.css",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "vite --port 40003"
  },
  "peerDependencies": {
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.0"
  },
  "dependencies": {
    "@retainpdf/api": "0.1.0",
    "@retainpdf/domain": "0.1.0",
    "@retainpdf/ui": "0.1.0",
    "marked": "^18.0.6",
    "mathjax-full": "^3.2.1",
    "pdfjs-dist": "^4.8.69",
    "react-pdf": "^9.2.1",
    "react-resizable-panels": "4.12.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^6.3.0"
  }
}
