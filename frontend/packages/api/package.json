{
  "name": "@retainpdf/api",
  "version": "0.1.0",
  "private": false,
  "description": "RetainPDF typed API clients backed by @retainpdf/contracts wire DTOs.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jobs": {
      "types": "./dist/jobs.d.ts",
      "import": "./dist/jobs.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./jobs-query": {
      "types": "./dist/jobs-query.d.ts",
      "import": "./dist/jobs-query.js"
    },
    "./jobs-artifacts": {
      "types": "./dist/jobs-artifacts.d.ts",
      "import": "./dist/jobs-artifacts.js"
    },
    "./jobs-events": {
      "types": "./dist/jobs-events.d.ts",
      "import": "./dist/jobs-events.js"
    },
    "./jobs-actions": {
      "types": "./dist/jobs-actions.d.ts",
      "import": "./dist/jobs-actions.js"
    },
    "./jobs-submit": {
      "types": "./dist/jobs-submit.d.ts",
      "import": "./dist/jobs-submit.js"
    },
    "./translation-debug": {
      "types": "./dist/translation-debug.d.ts",
      "import": "./dist/translation-debug.js"
    },
    "./live-translation": {
      "types": "./dist/live-translation.d.ts",
      "import": "./dist/live-translation.js"
    },
    "./documents": {
      "types": "./dist/documents.d.ts",
      "import": "./dist/documents.js"
    },
    "./collections": {
      "types": "./dist/collections.d.ts",
      "import": "./dist/collections.js"
    },
    "./glossaries": {
      "types": "./dist/glossaries.d.ts",
      "import": "./dist/glossaries.js"
    },
    "./backups": {
      "types": "./dist/backups.d.ts",
      "import": "./dist/backups.js"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "import": "./dist/sync.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js"
    },
    "./reader": {
      "types": "./dist/reader.d.ts",
      "import": "./dist/reader.js"
    },
    "./quality": {
      "types": "./dist/quality.d.ts",
      "import": "./dist/quality.js"
    },
    "./job-data": {
      "types": "./dist/job-data.d.ts",
      "import": "./dist/job-data.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./admin-platform": {
      "types": "./dist/admin-platform.d.ts",
      "import": "./dist/admin-platform.js"
    },
    "./usage": {
      "types": "./dist/usage.d.ts",
      "import": "./dist/usage.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js"
    },
    "./job-images": {
      "types": "./dist/job-images.d.ts",
      "import": "./dist/job-images.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "import": "./dist/credentials.js"
    },
    "./utils/strip-ocr": {
      "types": "./dist/utils/strip-ocr.d.ts",
      "import": "./dist/utils/strip-ocr.js"
    },
    "./internal/runtime": {
      "types": "./dist/internal/runtime.d.ts",
      "import": "./dist/internal/runtime.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate:client": "node ./scripts/generate-client.mjs",
    "generate:client:check": "node ./scripts/generate-client.mjs --check",
    "dev": "tsc --watch -p tsconfig.json",
    "verify:package": "node ./scripts/verify-package.mjs",
    "test": "npm run build && npm run verify:package",
    "prepack": "npm run build && npm run verify:package"
  },
  "dependencies": {
    "@retainpdf/contracts": "0.1.0"
  },
  "peerDependencies": {
    "zod": "^3.22.0"
  },
  "peerDependenciesMeta": {
    "zod": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
