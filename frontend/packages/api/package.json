    },
    "./conversations": {
      "types": "./dist/conversations.d.ts",
      "import": "./dist/conversations.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js"
    },
    "./reader": {
      "types": "./dist/reader.d.ts",
      "import": "./dist/reader.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js"
    },
    "./job-images": {
      "types": "./dist/job-images.d.ts",
      "import": "./dist/job-images.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
