    },
    "./utils/strip-ocr": {
      "types": "./dist/utils/strip-ocr.d.ts",
      "import": "./dist/utils/strip-ocr.js"
    },
    "./internal/runtime": {
      "types": "./dist/internal/runtime.d.ts",
      "import": "./dist/internal/runtime.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc --watch -p tsconfig.json",
    "verify:package": "node ./scripts/verify-package.mjs",
    "test": "npm run build && npm run verify:package",
    "prepack": "npm run build && npm run verify:package"
  },
  "dependencies": {
    "@retainpdf/contracts": "0.1.0"
  },
  "peerDependencies": {
    "zod": "^3.22.0"
  },
  "peerDependenciesMeta": {
    "zod": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
