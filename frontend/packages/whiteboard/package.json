{
  "name": "@retainpdf/whiteboard",
  "version": "0.1.0",
  "private": false,
  "description": "RetainPDF 白板讲解板：把 Teaching Agent 写的 JSON 讲解脚本一步一步画出来（docs/ops/planning/learning-system/20261125-白板讲解板.md）",
  "type": "module",
  "sideEffects": [
    "./styles/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles/whiteboard.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "clean": "node ./scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc --watch -p tsconfig.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@retainpdf/ui": "0.1.0",
    "mathjax-full": "^3.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^7.0.2"
  }
}
