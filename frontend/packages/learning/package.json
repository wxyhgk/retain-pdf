{
  "name": "@retainpdf/learning",
  "version": "0.1.0",
  "private": false,
  "description": "RetainPDF 学习系统的学习区：本章地图、知识点卡、做题、白板讲解、随时提问（docs/ops/planning/learning-system/）",
  "type": "module",
  "sideEffects": [
    "./styles/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles/learning.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "clean": "node ./scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc --watch -p tsconfig.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@retainpdf/ui": "0.1.0",
    "@retainpdf/whiteboard": "0.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^7.0.2"
  }
}
