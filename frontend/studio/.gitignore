# build output
dist/
# vendored editor experiments, not part of the published blog
vendor/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# browser test output
test-results/
playwright-report/

# files removed in the Studio, kept until emptied by hand
.studio-trash/
.studio-settings.json
# where the jobs running on other machines are (the Studio's 计算块)
.studio-jobs.json
# what the Studio builds for itself (RetainMol's page)
.studio-cache/
# where a project app is on this machine (apps/<名字>/app.local.json): not in the public repository
apps/*/app.local.json
# the AI panel's conversations (chats/<chat-…>/index.md and ai/): the author's, not published
/chats/

# an article's ai/: material for the AIs (a brief, ai/work/ an AI's scripts and log, ai/history/ earlier
# versions), never published and never committed: the repository is public. Only the folder itself is kept.
blog/*/ai/*
!blog/*/ai/.gitkeep
# the author's preferences the AIs note down (blog/AGENTS.md), local only
.agents/memory/

# videos in articles stay on the author's machine (too big for git); the page shows a ```video block's cover
# (LOCAL_ONLY_EXTENSIONS in packages/markdown/articles/rules.mjs)
blog/**/*.[mM][pP]4
blog/**/*.[mM]4[vV]
blog/**/*.[mM][oO][vV]
blog/**/*.[wW][eE][bB][mM]
blog/**/*.[mM][kK][vV]
