# dependencies
node_modules/
# vendored editor experiments
vendor/

# logs
# (仓库根目录的 .gitignore 不要 *.log；计算程序的输出样本是测试用的)
!packages/compute/test/fixtures/**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# browser test output
test-results/
playwright-report/

# this machine's own: where the notes are (notes-root.mjs)
.studio-local.json
# what the Studio builds for itself (the server's address, RetainMol's page, checkpoints of apps)
.studio-cache/
# where a project app is on this machine (apps/<名字>/app.local.json)
apps/*/app.local.json

# notes kept in this folder (when .studio-local.json names none, the Studio's notes are here): the author's, never
# this repository's
/blog/
/chats/
/repos/
/templates/
.studio-trash/
.studio-settings.json
.studio-jobs.json
.agents/memory/
