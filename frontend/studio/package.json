  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "rehype-stringify": "^10.0.1",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "studio": "bin/studio.mjs"
  }
}
