{
  "name": "notion2gitub_blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "npm run test:unit && npm run test:server",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:server": "node --test src/studio/server/*.test.mjs",
    "test:terminal": "cargo test --release --manifest-path tools/studio-terminal/Cargo.toml",
    "terminal:build": "cargo build --release --manifest-path tools/studio-terminal/Cargo.toml",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "milkdown:setup": "git submodule update --init third_party/milkdown && pnpm --dir third_party/milkdown install --frozen-lockfile"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@codemirror/language-data": "^6.5.2",
    "@milkdown/crepe": "^7.22.0",
    "@milkdown/ctx": "^7.22.0",
    "@milkdown/kit": "^7.22.0",
    "@milkdown/prose": "^7.22.0",
    "@milkdown/utils": "^7.22.0",
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "3dmol": "^2.5.5",
    "astro": "^7.2.0",
    "chem-structura": "^0.3.0",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "hast-util-raw": "^9.1.0",
    "hast-util-to-text": "^4.0.2",
    "katex": "^0.18.2",
    "micromark-util-character": "^2.1.1",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.2",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.0",
    "unified": "^11.0.5",
    "unist-util-visit-parents": "^6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "rehype-stringify": "^10.0.1",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "typescript": "^7.0.2"
  }
}
