{
  "name": "notion2gitub_blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "npm run test:unit && npm run test:server",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts packages/*/test/*.test.ts plugins/*/test/*.test.ts",
    "test:server": "node --test 'src/studio/server/**/*.test.mjs' src/articles/*.test.mjs plugins/*/test/*.test.mjs",
    "test:terminal": "cargo test --release --manifest-path tools/studio-terminal/Cargo.toml",
    "terminal:build": "cargo build --release --manifest-path tools/studio-terminal/Cargo.toml",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "milkdown:setup": "git submodule update --init third_party/milkdown && pnpm --dir third_party/milkdown install --frozen-lockfile",
    "studio": "node bin/studio.mjs",
    "studio:serve": "node src/studio/serve.mjs",
    "i18n:strings": "node packages/i18n/strings.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.95.0",
    "@agentclientprotocol/codex-acp": "2.2.2",
    "@agentclientprotocol/sdk": "2.0.2",
    "@anthropic-ai/sdk": "0.132.1",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@blog/i18n": "*",
    "@blog/markdown": "*",
    "@blog/office": "*",
    "@blog/science": "*",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/view": "^6.43.8",
    "@deepseek-ai/cordis": "4.0.5",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@milkdown/crepe": "^7.22.0",
    "@milkdown/ctx": "^7.22.0",
    "@milkdown/kit": "^7.22.0",
    "@milkdown/prose": "^7.22.0",
    "@milkdown/utils": "^7.22.0",
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "astro": "^7.2.0",
    "chem-structura": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "hast-util-raw": "^9.1.0",
    "hast-util-to-text": "^4.0.2",
    "jszip": "3.10.2",
    "katex": "^0.18.2",
    "lucide-react": "1.61.0",
    "micromark-util-character": "^2.1.1",
    "pi-acp": "0.0.34",
    "pinyin-pro": "3.29.4",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
