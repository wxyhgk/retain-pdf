#!/bin/sh
# A stand-in for `paddleocr api` (OCR 成子页面): writes what PaddleOCR's document parsing gave for a page
# (src/studio/server/test-data/paddleocr-figure.md) where --output_md says, its picture next to it.
here="$(cd "$(dirname "$0")" && pwd)"
out=""
while [ $# -gt 0 ]; do
	[ "$1" = "--output_md" ] && out="$2"
	shift
done
mkdir -p "$(dirname "$out")/imgs"
