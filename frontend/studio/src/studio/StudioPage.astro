---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';
import { ArticleRepository } from './server/articles/article-repository.mjs';
import { pageVersion, studioBlogRoot } from './server/articles/page-version.mjs';
import { SideTabs } from './shell/SideTabs';
import { Sidebar } from './shell/Sidebar';
import { TopBar } from './shell/TopBar';
// The editor's styles in the page itself, not added by its scripts later, so the first picture is drawn as the editor draws it.
import '@milkdown/crepe/theme/common/style.css';
import '@milkdown/crepe/theme/classic.css';
import '@blog/markdown/callouts/callouts.css';
import '@blog/markdown/code-files/code-files.css';
import '@blog/markdown/figures/figures.css';
import '@blog/markdown/references/references.css';
import '@blog/office/office.css';
import '@xterm/xterm/css/xterm.css';
import './tokens.css';
import './shell/shell.css';
import './shell/sidebar-hosts.css';
import './files/drive.css';
import './pages/article-table.css';
import './ai/ai-panel.css';
import '@blog/ui/block-sheet.css';
// KaTeX draws nothing until its fonts are in: the ones most formulas use, asked for with the page.
import katexMain from 'katex/dist/fonts/KaTeX_Main-Regular.woff2?url';
import katexMath from 'katex/dist/fonts/KaTeX_Math-Italic.woff2?url';
import katexSize1 from 'katex/dist/fonts/KaTeX_Size1-Regular.woff2?url';
import katexSize2 from 'katex/dist/fonts/KaTeX_Size2-Regular.woff2?url';
import katexAms from 'katex/dist/fonts/KaTeX_AMS-Regular.woff2?url';

// The mark of what the page shows with each article open (page-snapshot.ts); the
// address, which picks the article, is the browser's to read.
const blogRoot = studioBlogRoot(process.cwd());
const articles = await new ArticleRepository(blogRoot).list().catch(() => []);
const pages = { first: articles[0]?.slug ?? null, versions: Object.fromEntries(await Promise.all(articles.map(async ({ slug }) => [slug, await pageVersion(blogRoot, slug)]))) };
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`Studio · ${SITE_TITLE}`} description="本地文章工作台" />
		{[katexMain, katexMath, katexSize1, katexSize2, katexAms].map((font) => <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />)}
		<!-- React's fast refresh for the shell (shell/), before its components load: what @astrojs/react puts in a page with islands only. -->
		<script is:inline type="module">
			import { injectIntoGlobalHook } from '/@react-refresh';
			injectIntoGlobalHook(window);
			window.$RefreshReg$ = () => {};
			window.$RefreshSig$ = () => (type) => type;
		</script>
	</head>
	<body class="studio-body">
		<main class="studio-shell">
			<!-- The shell, drawn by React (shell/): here as the server draws it, then by the page's script (mount.tsx). -->
			<aside class="article-sidebar" data-ui><Sidebar siteTitle={SITE_TITLE} /></aside>

			<section class="workspace-main">
				<header class="studio-bar" data-ui><TopBar siteTitle={SITE_TITLE} /></header>

				<section class="editor-panel" aria-label="文章编辑器">
					<div class="panel-label">
						<span id="editor-path">选择一篇文章</span>
						<span id="roundtrip-status">等待载入</span>
					</div>
					<div id="review-bar" class="review-bar" role="status" hidden>
						<span id="review-count"></span>
						<span id="review-hint" class="review-hint">已经保存在磁盘上；拒绝的会改回去</span>
						<button id="review-retry" type="button" hidden>重试</button>
						<button id="review-reject-all" type="button">全部拒绝</button>
						<button id="review-accept-all" type="button" class="review-accept">全部接受</button>
					</div>
					<div class="editor-scroll">
					<header class="document-header">
						<div id="page-cover" class="page-cover" hidden>
							<img alt="" />
							<div class="page-cover-actions">
								<button id="change-cover" type="button">更换封面</button>
								<button id="remove-cover" type="button">移除</button>
							</div>
						</div>
						<div class="page-head">
							<button id="page-icon" class="page-emoji" type="button" aria-label="更换图标" hidden></button>
							<div class="page-head-actions">
								<button id="add-icon" type="button" disabled>☺ 添加图标</button>
								<button id="add-cover" type="button" disabled>▨ 添加封面</button>
							</div>
							<input id="article-title-input" class="article-title-input" type="text" aria-label="文章标题" placeholder="无标题" disabled />
							<div class="page-properties" role="group" aria-label="属性">
								<span class="property-name">◷ 发布日期</span>
								<input id="article-pub-date" class="property-value" type="date" aria-label="发布日期" disabled />
								<span class="property-name">⌗ 标签</span>
								<div id="article-tags" class="property-value tag-field">
									<input id="article-tag-input" type="text" list="known-tags" aria-label="添加标签" placeholder="空" disabled />
									<datalist id="known-tags"></datalist>
								</div>
								<span class="property-name">≡ 简介</span>
								<textarea id="article-description" class="property-value" rows="1" aria-label="简介" placeholder="空" disabled></textarea>
								<span class="property-name">◫ 类型</span>
								<select id="article-kind" class="property-value" aria-label="类型" disabled>
									<option value="post">博客</option>
									<option value="wiki">维基</option>
								</select>
								<span class="property-name">◌ 状态</span>
								<div class="property-value status-field">
									<span id="article-status" class="status-pill">草稿</span>
									<button id="publish-article" class="status-action" type="button" disabled>发布</button>
								</div>
								<div id="page-backlinks" class="page-backlinks" hidden></div>
							</div>
							<p id="property-error" role="alert" hidden></p>
						</div>
					</header>
					<div id="crepe-editor" class="crepe-host" aria-label="文章编辑器"></div>
					</div>
					<nav id="editor-outline" class="outline-rail" aria-label="文章目录" hidden>
						<div class="outline-pop"><ol></ol></div>
						<div class="outline-marks" aria-hidden="true"></div>
					</nav>
				</section>
				<section id="drive-view" class="drive-page" aria-label="资料库" hidden></section>
				<section id="table-view" class="table-page" aria-label="全部文章" hidden></section>
				<!-- AI 问答: the AI tab's panel, moved here whole (main.ts showChat). -->
				<section id="chat-view" class="chat-view" aria-label="AI 问答" hidden></section>
			</section>

			<aside id="side-panel" class="side-panel" aria-label="AI、文件与终端">
				<div class="side-panel-resizer" role="separator" aria-orientation="vertical" aria-label="调整面板宽度" tabindex="0" title="拖动调整宽度，双击恢复"></div>
				<div class="side-tabs" role="tablist" aria-label="右侧面板" data-ui><SideTabs /></div>
				<!-- The AI (ai-panel.ts draws it). -->
				<section id="side-ai" class="side-pane ai-pane" role="tabpanel" aria-labelledby="side-tab-ai" hidden></section>
				<section id="side-files" class="side-pane" role="tabpanel" aria-labelledby="side-tab-files">
					<header class="pane-toolbar">
						<span id="files-root" class="pane-path">未打开文章</span>
						<div class="pane-actions">
							<button id="upload-files" type="button" title="上传文件；文件和整个文件夹也可以直接拖进来" aria-label="上传文件" disabled>⤒</button>
							<button id="new-folder" type="button" title="新建文件夹" aria-label="新建文件夹" disabled>＋</button>
							<button id="refresh-files" type="button" title="重新读取文件夹" aria-label="刷新" disabled>↻</button>
						</div>
						<input id="file-upload-input" type="file" multiple hidden />
					</header>
					<div id="file-tree" class="file-tree"></div>
					<p id="files-status" class="files-status" role="status" aria-live="polite"></p>
				</section>
				<section id="side-drive" class="side-pane" role="tabpanel" aria-labelledby="side-tab-drive" hidden></section>
				<section id="side-terminal" class="side-pane" role="tabpanel" aria-labelledby="side-tab-terminal" hidden>
					<header class="pane-toolbar">
						<div class="cwd-switch" role="radiogroup" aria-label="终端启动目录">
							<button type="button" role="radio" data-cwd="root" aria-checked="true">仓库根目录</button>
							<button type="button" role="radio" data-cwd="article" aria-checked="false">当前文章</button>
							<button type="button" role="radio" data-cwd="drive" aria-checked="false" title="先在左侧「资料库」里选好文件夹">资料库</button>
						</div>
						<span id="terminal-cwd" class="pane-path"></span>
						<div class="pane-actions">
							<button id="restart-terminal" type="button" title="重新打开终端" aria-label="重新打开终端">↻</button>
						</div>
					</header>
					<div id="terminal-agents" class="terminal-agents" role="group" aria-label="在终端里启动 AI" hidden></div>
					<div id="terminal-screen" class="terminal-screen" aria-label="终端"></div>
				</section>
			</aside>
			<!-- The background tasks: an AI doing what a line asks, a PDF being read (task-tray.ts). -->
			<div id="task-tray" class="task-tray" aria-live="polite" hidden></div>
			<!-- The 小程序's floating windows (mini-apps.ts). -->
			<div id="mini-app-layer" class="mini-app-layer"></div>
		</main>
		<script is:inline define:vars={{ pages }}>
			// Before the editor loads: the right column as it was left, and the page as
			// it was left (page-snapshot.ts) over it while nothing it shows has changed.
			try {
				const shell = document.querySelector('.studio-shell');
				const layout = JSON.parse(localStorage.getItem('studio.side-panel') ?? 'null');
				if (layout?.open === false) shell.classList.add('panel-collapsed');
				if (typeof layout?.width === 'number') shell.style.setProperty('--panel-width', `${Math.min(720, Math.max(260, Math.round(layout.width)))}px`);
				// The article main.ts opens: the address's, or the first.
				const address = new URLSearchParams(window.location.search);
				const slug = Object.hasOwn(pages.versions, address.get('article')) ? address.get('article') : pages.first;
				const kept = JSON.parse(localStorage.getItem('studio.snapshot') ?? 'null');
				if (slug && !address.has('drive') && !address.has('pages') && kept?.slug === slug && kept.version === pages.versions[slug] && !navigator.webdriver) {
					const template = document.createElement('template');
					template.innerHTML = kept.html;
					const picture = template.content.firstElementChild;
					picture.classList.add('studio-snapshot');
					picture.inert = true;
					picture.setAttribute('aria-hidden', 'true');
					shell.after(picture);
					// Should the editor never come, the page as it is.
					setTimeout(() => picture.remove(), 10000);
				}
			} catch {
				// Storage refused, or a picture from another version of the page: it loads as it is.
			}
		</script>

		<!-- What the shell opens over the page: dialogs, menus, the message at the bottom (mount.tsx). -->
		<div id="ui-layer" data-ui></div>

		<script>import './main';</script>
	</body>
</html>

<style>
	:global(body.studio-body) { height: 100vh; overflow: hidden; font-size: 16px; }
	.studio-shell { --sidebar: var(--studio-sidebar-width); --panel: var(--panel-width, var(--studio-panel-width)); display: grid; grid-template-columns: var(--sidebar) minmax(0, 1fr) var(--panel); width: 100%; max-width: none; height: 100vh; margin: 0; padding: 0; transition: grid-template-columns 180ms ease; }
	.studio-shell.sidebar-collapsed { --sidebar: 0px; }
	/* The page as it was left, over the page while the editor loads (page-snapshot.ts); until then the page shows no empty fields. */
	.studio-shell.studio-snapshot { position: fixed; inset: 0; z-index: 30; }
	.studio-shell:not([data-ready]) .editor-scroll { visibility: hidden; }
	.studio-shell.panel-collapsed { --panel: 0px; }
	.studio-shell.is-resizing { transition: none; cursor: col-resize; user-select: none; }
	.article-sidebar, .workspace-main, .editor-panel, .side-panel { min-width: 0; overflow: hidden; background: var(--surface); }
	.article-sidebar { display: flex; flex-direction: column; border-right: 1px solid rgb(var(--gray-light)); background: var(--surface-soft); transition: opacity 120ms ease; }
	.studio-shell.sidebar-collapsed .article-sidebar { opacity: 0; pointer-events: none; }
	.chat-view { display: flex; flex: 1; min-height: 0; flex-direction: column; background: var(--surface); }
	.chat-view[hidden] { display: none; }
	.workspace-main { display: flex; min-height: 0; flex-direction: column; }
	.studio-bar { position: relative; z-index: 10; display: flex; flex: none; align-items: center; justify-content: space-between; height: 46px; padding: 0 10px; border-bottom: 1px solid rgb(var(--gray-light)); background: var(--surface); }
	/* 全宽: the page as wide as the editor allows, as on the blog. */
	.editor-panel.is-wide .page-head, .editor-panel.is-wide :global(.crepe-host .milkdown .ProseMirror) { width: min(100%, 1180px); }
	.panel-label { display: none; }
	.panel-label { color: rgb(var(--gray)); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.04em; }
	/* Chosen with ⌘ or ⇧ to move or delete together. */
	/* ⋯ on hover, over the badges at the end of the row. */
	/* Above the title of a page under others: the way up to them. */
	:global(.page-path) { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 4px; margin: 0 0 4px; color: rgb(var(--gray)); font-size: 13px; }
	:global(.page-path[hidden]) { display: none; }
	:global(.page-path-link) { padding: 1px 4px; border: 0; border-radius: 4px; background: transparent; color: inherit; font: inherit; cursor: pointer; }
	:global(.page-path-link:hover) { background: rgb(var(--gray-light)); color: rgb(var(--gray-dark)); }
	:global(.page-path-separator) { padding: 1px 3px; border: 0; border-radius: 4px; background: transparent; color: inherit; font: inherit; opacity: 0.6; cursor: pointer; }
	:global(.page-path-separator:hover) { background: rgb(var(--gray-light)); opacity: 1; }
	/* The tree: each level 14px further in, the triangle that folds what is under a page left of it. */
	/* Dragged onto a page: under it. Below the pages: at the top. */
	/* Above or below a page: a line there, as far in as the page. */
	.editor-panel { position: relative; display: flex; flex: 1; min-height: 0; flex-direction: column; }
	/* The drive in the middle, the article kept open behind it; the bar keeps only the side panel's button. */
	.drive-page { display: flex; flex: 1; min-height: 0; flex-direction: column; padding: 28px clamp(20px, 5vw, 64px) 12px; }
	.drive-page[hidden] { display: none; }
	.studio-shell:is([data-view='drive'], [data-view='table'], [data-view='chat']) .editor-panel { display: none; }
	/*
	 * Scrollbars: thin, a rounded gray thumb on no track, darker under the pointer. The system's
	 * (WebKit's, in the Mac app) are bars of their own, light on a dark page.
	 */
	:global(*::-webkit-scrollbar) { width: 10px; height: 10px; }
	:global(*::-webkit-scrollbar-track), :global(*::-webkit-scrollbar-corner) { background: transparent; }
	:global(*::-webkit-scrollbar-thumb) { border: 3px solid transparent; border-radius: 999px; background: rgba(var(--gray), 0.3) padding-box; }
	:global(*::-webkit-scrollbar-thumb:hover) { background-color: rgba(var(--gray), 0.55); }

	/* The outline at the editor's right edge, as on the blog: clear of the editor's scrollbar. */
	.outline-rail { position: absolute; z-index: 12; top: 96px; right: 16px; display: flex; align-items: flex-start; pointer-events: none; }
	.outline-rail[hidden] { display: none; }
	.outline-pop { width: 220px; max-height: min(68vh, 520px); margin-right: 2px; overflow: auto; border-radius: 8px; background: var(--surface); box-shadow: 0 6px 24px rgba(15, 15, 15, 0.1); opacity: 0; pointer-events: none; transition: opacity 120ms ease; }
	.outline-rail:hover .outline-pop, .outline-rail:focus-within .outline-pop { opacity: 1; pointer-events: auto; }
	.outline-pop ol { display: grid; gap: 1px; margin: 0; padding: 4px; list-style: none; }
	.outline-pop :global(a) { display: block; padding: 3px 8px; border-radius: 4px; color: rgb(var(--gray)); font-size: 13px; line-height: 1.35; text-align: right; text-decoration: none; }
	.outline-pop :global(li.child a) { font-size: 12px; }
	.outline-pop :global(a:hover) { background: var(--surface-hover); color: rgb(var(--black)); }
	.outline-pop :global(a[aria-current]) { color: rgb(var(--black)); font-weight: 600; }
	/* A short line a heading, the lower levels shorter: their shape, not a ruler. The one the reader is in, dark. */
	.outline-marks { display: grid; justify-items: end; gap: 8px; width: 24px; padding: 8px 4px; pointer-events: auto; }
	.outline-marks :global(i) { display: block; width: 16px; height: 2px; border-radius: 2px; background: rgba(var(--gray), 0.32); transition: background-color 120ms ease; }
	.outline-marks :global(i.child) { width: 9px; }
	.outline-marks :global(i[data-current]) { background: rgb(var(--gray-dark)); }
	.outline-rail:hover .outline-marks :global(i:not([data-current])) { background: rgba(var(--gray), 0.5); }
	.panel-label > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	#roundtrip-status { margin-left: 14px; color: rgb(var(--gray)); font-size: 9px; }
	#roundtrip-status[data-state='changed'] { color: var(--danger); }
	#roundtrip-status[data-state='exact'] { color: rgb(var(--gray)); }
	.editor-scroll { position: relative; flex: 1; min-height: 0; overflow-y: auto; background: var(--surface); }
	.review-bar { display: flex; flex: none; align-items: center; gap: 10px; padding: 8px 20px; border-bottom: 1px solid color-mix(in srgb, var(--accent) 25%, rgb(var(--gray-light))); background: color-mix(in srgb, var(--accent) 7%, var(--surface)); font-size: 13px; }
	.review-bar[hidden] { display: none; }
	.review-bar #review-count { font-weight: 700; }
	.review-bar .review-hint { flex: 1; min-width: 0; overflow: hidden; color: rgb(var(--gray)); font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
	.review-bar button { padding: 4px 12px; border: 1px solid rgb(var(--gray-light)); border-radius: 6px; background: var(--surface); color: inherit; font: inherit; cursor: pointer; }
	.review-bar button.review-accept { border-color: var(--accent); background: var(--accent); color: var(--on-accent); font-weight: 700; }
	.document-header { box-sizing: border-box; width: 100%; background: transparent; }
	.page-head { box-sizing: border-box; position: relative; width: min(100%, var(--studio-editor-width)); margin: 0 auto; padding: 52px var(--studio-editor-padding) 0; }
	.document-header.has-cover .page-head { padding-top: 22px; }
	.document-header.has-cover.has-icon .page-head { padding-top: 0; }
	/* The cover spans the page, as on the blog. */
	.page-cover { position: relative; height: 30vh; max-height: 280px; min-height: 160px; overflow: hidden; background: var(--surface-soft); }
	.page-cover[hidden] { display: none; }
	.page-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
	.page-cover-actions { position: absolute; right: max(24px, calc(50% - 400px)); bottom: 12px; display: flex; gap: 0; border-radius: 6px; background: rgba(255, 255, 255, 0.92); box-shadow: 0 1px 4px rgba(15, 15, 15, 0.12); opacity: 0; transition: opacity 120ms ease; }
	.page-cover:hover .page-cover-actions, .page-cover:focus-within .page-cover-actions { opacity: 1; }
	.page-cover-actions button { padding: 5px 10px; border: 0; background: transparent; color: rgb(var(--gray-dark)); font: inherit; font-size: 12px; cursor: pointer; }
	.page-cover-actions button + button { border-left: 1px solid rgb(var(--gray-light)); }
	.page-cover-actions button:hover { background: rgba(55, 53, 47, 0.08); }
	.page-emoji { display: block; width: 78px; height: 78px; margin: 0 0 4px -4px; padding: 0; border: 0; border-radius: 6px; background: transparent; font-size: 64px; line-height: 78px; text-align: center; cursor: pointer; }
	.page-emoji[hidden] { display: none; }
	.page-emoji:hover { background: var(--surface-soft); }
	.document-header.has-cover .page-emoji { margin-top: -40px; position: relative; }
	.page-head-actions { display: flex; gap: 4px; min-height: 28px; margin-bottom: 4px; opacity: 0; transition: opacity 120ms ease; }
	.page-head:hover .page-head-actions, .page-head-actions:focus-within { opacity: 1; }
	.page-head-actions button { padding: 4px 7px; border: 0; border-radius: 5px; background: transparent; color: rgb(var(--gray)); font: inherit; font-size: 13px; cursor: pointer; }
	.page-head-actions button:hover { background: var(--surface-soft); color: rgb(var(--gray-dark)); }
	.page-head-actions button[hidden] { display: none; }
	/* Icon and cover both there: nothing to add, no row for it. */
	:global(.page-head-actions:not(:has(button:not([hidden])))) { display: none; }
	.article-title-input { box-sizing: border-box; width: 100%; padding: 0; border: 0; background: transparent; color: rgb(var(--black)); font-family: var(--font-text); font-size: var(--studio-title-size); font-weight: 700; letter-spacing: -0.025em; line-height: 1.2; outline: none; }
	.article-title-input::placeholder { color: rgb(var(--gray)); opacity: 0.48; }
	.article-title-input:disabled { opacity: 0.55; }
	/* Properties as rows: a name, and its value changed where it is. */
	.page-properties { display: grid; grid-template-columns: 132px minmax(0, 1fr); align-items: start; gap: 1px 6px; margin-top: 14px; padding-bottom: 12px; border-bottom: 1px solid rgb(var(--gray-light)); font-size: 14px; }
	.property-name { padding: 6px 6px; color: rgb(var(--gray)); line-height: 20px; white-space: nowrap; }
	.property-value { box-sizing: border-box; min-height: 32px; width: 100%; margin: 0; padding: 6px 8px; border: 0; border-radius: 5px; background: transparent; color: rgb(var(--gray-dark)); font: inherit; font-size: 14px; line-height: 20px; outline: none; }
	.property-value:hover, .property-value:focus, .property-value:focus-within { background: var(--surface-soft); }
	textarea.property-value { display: block; resize: none; overflow: hidden; }
	.property-value::placeholder, .tag-field input::placeholder { color: rgb(var(--gray)); opacity: 0.6; }
	select.property-value { appearance: none; cursor: pointer; }
	input[type='date'].property-value { cursor: text; }
	input[type='date'].property-value::-webkit-calendar-picker-indicator { opacity: 0; cursor: pointer; }
	input[type='date'].property-value:hover::-webkit-calendar-picker-indicator, input[type='date'].property-value:focus::-webkit-calendar-picker-indicator { opacity: 0.6; }
	.tag-field { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; padding-block: 4px; cursor: text; }
	.tag-field input { flex: 1; min-width: 80px; padding: 2px 0; border: 0; background: transparent; color: inherit; font: inherit; outline: none; }
