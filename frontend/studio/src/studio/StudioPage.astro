---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={`Studio · ${SITE_TITLE}`} description="本地文章工作台" /></head>
	<body class="studio-body">
		<main class="studio-shell">
			<aside class="article-sidebar">
				<div class="workspace-heading">
					<a href="/" class="workspace-identity"><span class="workspace-avatar">C</span><strong>{SITE_TITLE}</strong></a>
					<span class="studio-badge">Studio</span>
				</div>
				<div class="workspace-navigation">
					<a href="/"><span>⌂</span>首页</a>
					<button id="open-search" class="article-search" type="button"><span>⌕</span>搜索<kbd>⌘K</kbd></button>
				</div>
				<div class="panel-heading"><h1>Private</h1><button id="new-article" type="button" title="新建文章" aria-label="新建文章">＋</button></div>
				<nav id="article-list" aria-label="页面列表"></nav>
				<div class="sidebar-footer">
					<button id="new-article-secondary" type="button"><span>＋</span>新建文章</button>
					<a href="/blog/"><span>◫</span>博客首页</a>
					<button id="open-trash" type="button"><span>♲</span>回收站</button>
				</div>
			</aside>

			<section class="workspace-main">
				<header class="studio-bar">
					<div class="document-breadcrumb">
						<button id="toggle-sidebar" type="button" aria-label="收起侧边栏" aria-pressed="false">◧</button>
						<span class="breadcrumb-workspace">{SITE_TITLE}</span><span class="breadcrumb-separator">/</span><strong id="breadcrumb-title">选择一篇文章</strong>
					</div>
					<div class="studio-actions">
						<span id="edited-at" class="edited-at"></span>
						<span id="save-status" class="save-status" title="改动会自动保存，⌘S 立即保存" aria-live="polite">正在连接…</span>
						<a id="open-article" href="/blog" target="_blank">打开博客</a>
						<button id="page-menu" class="icon-action" type="button" aria-label="页面菜单" title="页面菜单">⋯</button>
						<button id="toggle-side-panel" class="icon-action" type="button" aria-pressed="true" aria-label="收起右侧面板" title="文件与终端">◨</button>
					</div>
				</header>

				<section class="editor-panel" aria-label="文章编辑器">
					<div class="panel-label">
						<span id="editor-path">选择一篇文章</span>
						<span id="roundtrip-status">等待载入</span>
					</div>
					<div id="review-bar" class="review-bar" role="status" hidden>
						<span id="review-count"></span>
						<span class="review-hint">已经保存在磁盘上；拒绝的会改回去</span>
						<button id="review-reject-all" type="button">全部拒绝</button>
						<button id="review-accept-all" type="button" class="review-accept">全部接受</button>
					</div>
					<div class="editor-scroll">
					<header class="document-header">
						<div id="page-cover" class="page-cover" hidden>
							<img alt="" />
							<div class="page-cover-actions">
								<button id="change-cover" type="button">更换封面</button>
								<button id="remove-cover" type="button">移除</button>
							</div>
						</div>
						<div class="page-head">
							<button id="page-icon" class="page-emoji" type="button" aria-label="更换图标" hidden></button>
							<div class="page-head-actions">
								<button id="add-icon" type="button" disabled>☺ 添加图标</button>
								<button id="add-cover" type="button" disabled>▨ 添加封面</button>
							</div>
							<input id="article-title-input" class="article-title-input" type="text" aria-label="文章标题" placeholder="无标题" disabled />
							<div class="page-properties" role="group" aria-label="属性">
								<span class="property-name">◷ 发布日期</span>
								<input id="article-pub-date" class="property-value" type="date" aria-label="发布日期" disabled />
								<span class="property-name">⌗ 标签</span>
								<div id="article-tags" class="property-value tag-field">
									<input id="article-tag-input" type="text" list="known-tags" aria-label="添加标签" placeholder="空" disabled />
									<datalist id="known-tags"></datalist>
								</div>
								<span class="property-name">≡ 简介</span>
								<textarea id="article-description" class="property-value" rows="1" aria-label="简介" placeholder="空" disabled></textarea>
								<span class="property-name">◫ 类型</span>
								<select id="article-kind" class="property-value" aria-label="类型" disabled>
									<option value="post">博客</option>
									<option value="wiki">维基</option>
								</select>
								<span class="property-name">◌ 状态</span>
								<div class="property-value status-field">
									<span id="article-status" class="status-pill">草稿</span>
									<button id="publish-article" class="status-action" type="button" disabled>发布</button>
								</div>
							</div>
							<p id="property-error" role="alert" hidden></p>
						</div>
					</header>
					<div id="crepe-editor" class="crepe-host" aria-label="文章编辑器"></div>
					</div>
					<nav id="editor-outline" class="outline-rail" aria-label="文章目录" hidden>
						<div class="outline-pop"><ol></ol></div>
						<div class="outline-marks" aria-hidden="true"></div>
					</nav>
				</section>
			</section>

			<aside id="side-panel" class="side-panel" aria-label="文件与终端">
				<div class="side-panel-resizer" role="separator" aria-orientation="vertical" aria-label="调整面板宽度" tabindex="0" title="拖动调整宽度，双击恢复"></div>
				<div class="side-tabs" role="tablist" aria-label="右侧面板">
					<button id="side-tab-files" role="tab" type="button" aria-controls="side-files" aria-selected="true">文件</button>
					<button id="side-tab-terminal" role="tab" type="button" aria-controls="side-terminal" aria-selected="false">终端</button>
					<button id="close-side-panel" class="side-close" type="button" aria-label="收起右侧面板">×</button>
				</div>
				<section id="side-files" class="side-pane" role="tabpanel" aria-labelledby="side-tab-files">
					<header class="pane-toolbar">
						<span id="files-root" class="pane-path">未打开文章</span>
						<div class="pane-actions">
							<button id="upload-files" type="button" title="上传文件；文件和整个文件夹也可以直接拖进来" aria-label="上传文件" disabled>⤒</button>
							<button id="new-folder" type="button" title="新建文件夹" aria-label="新建文件夹" disabled>＋</button>
							<button id="refresh-files" type="button" title="重新读取文件夹" aria-label="刷新" disabled>↻</button>
						</div>
						<input id="file-upload-input" type="file" multiple hidden />
					</header>
					<div id="file-tree" class="file-tree"></div>
					<p id="files-status" class="files-status" role="status" aria-live="polite"></p>
				</section>
				<section id="side-terminal" class="side-pane" role="tabpanel" aria-labelledby="side-tab-terminal" hidden>
					<header class="pane-toolbar">
						<div class="cwd-switch" role="radiogroup" aria-label="终端启动目录">
							<button type="button" role="radio" data-cwd="root" aria-checked="true">仓库根目录</button>
							<button type="button" role="radio" data-cwd="article" aria-checked="false">当前文章</button>
						</div>
						<span id="terminal-cwd" class="pane-path"></span>
						<div class="pane-actions">
							<button id="restart-terminal" type="button" title="重新打开终端" aria-label="重新打开终端">↻</button>
						</div>
					</header>
					<div id="terminal-screen" class="terminal-screen" aria-label="终端"></div>
				</section>
			</aside>
		</main>

		<dialog id="quick-find-dialog" class="quick-find" aria-label="搜索">
			<label class="quick-find-field"><span aria-hidden="true">⌕</span><input id="quick-find-input" type="text" placeholder="搜索标题和正文…" autocomplete="off" aria-controls="quick-find-results" /></label>
			<ul id="quick-find-results" class="quick-find-results" role="listbox" aria-label="搜索结果"></ul>
			<p class="quick-find-hint"><kbd>↑</kbd><kbd>↓</kbd> 选择 · <kbd>↵</kbd> 打开 · <kbd>esc</kbd> 关闭</p>
		</dialog>

		<dialog id="trash-dialog" class="article-dialog trash-view">
			<form method="dialog">
				<div class="dialog-heading">
					<div><strong>回收站</strong><span>删除的文章和文件保留 30 天</span></div>
					<button type="submit" aria-label="关闭">×</button>
				</div>
				<ul id="trash-list" class="trash-list"></ul>
				<p id="trash-status" class="trash-status" role="status" aria-live="polite"></p>
			</form>
		</dialog>

		<dialog id="publish-check-dialog" class="article-dialog publish-check">
			<form method="dialog">
				<div class="dialog-heading">
					<div><strong>发布前检查</strong><span id="publish-check-summary"></span></div>
					<button type="submit" value="cancel" aria-label="关闭">×</button>
				</div>
				<ul id="publish-check-list" class="publish-check-list"></ul>
				<div class="dialog-actions">
					<button id="publish-check-cancel" type="submit" value="cancel">先不发布</button>
					<button id="publish-anyway" class="is-primary" type="submit" value="publish">仍然发布</button>
				</div>
			</form>
		</dialog>

		<dialog id="new-article-dialog" class="article-dialog">
			<form id="new-article-form">
				<div class="dialog-heading">
					<div><strong>新建文章</strong><span>创建一个完整的文章文件夹</span></div>
					<button id="cancel-new-article" type="button" aria-label="关闭">×</button>
				</div>
				<label>
					<span>标题</span>
					<input id="new-article-title" name="title" type="text" autocomplete="off" placeholder="例如：Hartree–Fock 学习笔记" required />
				</label>
				<label>
					<span>文件夹名称</span>
					<div class="slug-field"><span>blog/</span><input id="new-article-slug" name="slug" type="text" autocomplete="off" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" required /><span>/</span></div>
					<small>只能使用小写字母、数字和连字符，创建后暂不支持修改。</small>
				</label>
				<p id="new-article-error" class="dialog-error" role="alert" hidden></p>
				<div class="dialog-actions">
					<button id="cancel-new-article-secondary" type="button">取消</button>
					<button id="create-article" type="submit">创建并打开</button>
				</div>
			</form>
		</dialog>

		<script>import './main';</script>
	</body>
</html>

<style>
	:global(body.studio-body) { height: 100vh; overflow: hidden; font-size: 16px; }
	.studio-shell { --sidebar: 250px; --panel: var(--panel-width, 340px); display: grid; grid-template-columns: var(--sidebar) minmax(0, 1fr) var(--panel); width: 100%; max-width: none; height: 100vh; margin: 0; padding: 0; transition: grid-template-columns 180ms ease; }
	.studio-shell.sidebar-collapsed { --sidebar: 0px; }
	.studio-shell.panel-collapsed { --panel: 0px; }
	.studio-shell.is-resizing { transition: none; cursor: col-resize; user-select: none; }
	.article-sidebar, .workspace-main, .editor-panel, .side-panel { min-width: 0; overflow: hidden; background: var(--surface); }
	.article-sidebar { display: flex; flex-direction: column; border-right: 1px solid rgb(var(--gray-light)); background: var(--surface-soft); transition: opacity 120ms ease; }
	.studio-shell.sidebar-collapsed .article-sidebar { opacity: 0; pointer-events: none; }
	.workspace-heading { display: flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 11px; }
	.workspace-identity { display: flex; flex: 1; align-items: center; gap: 8px; min-width: 0; color: rgb(var(--gray-dark)); text-decoration: none; }
	.workspace-avatar { display: grid; flex: none; width: 23px; height: 23px; place-items: center; border-radius: 5px; background: var(--accent); color: var(--on-accent); font-size: 11px; font-weight: 800; }
	.workspace-identity strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; }
	.studio-badge { padding: 2px 5px; border-radius: 4px; background: rgb(var(--gray-light)); color: rgb(var(--gray)); font-size: 8px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
	.workspace-navigation { display: grid; gap: 2px; padding: 4px 7px 9px; }
	.workspace-navigation a, .article-search, .sidebar-footer a, .sidebar-footer button { display: flex; align-items: center; gap: 9px; min-height: 31px; padding: 0 8px; border: 0; border-radius: 6px; background: transparent; color: rgb(var(--gray-dark)); font: inherit; font-size: 12px; text-align: left; text-decoration: none; }
	.workspace-navigation a:hover, .article-search:hover, .sidebar-footer a:hover, .sidebar-footer button:hover { background: rgb(var(--gray-light)); }
	.article-search { width: 100%; cursor: pointer; }
	.article-search kbd { margin-left: auto; color: rgb(var(--gray)); font: inherit; font-size: 10px; opacity: 0.8; }
	.workspace-navigation a > span, .article-search > span, .sidebar-footer > * > span { width: 15px; color: rgb(var(--gray)); text-align: center; }
	.panel-heading { display: flex; align-items: center; justify-content: space-between; min-height: 31px; padding: 0 11px 0 15px; }
	.panel-heading h1 { margin: 0; color: rgb(var(--gray)); font-size: 10px; font-weight: 700; letter-spacing: 0.04em; }
	.panel-heading button { width: 23px; height: 23px; border: 0; border-radius: 5px; background: transparent; color: rgb(var(--gray)); font-size: 17px; cursor: pointer; }
	.panel-heading button:hover { background: rgb(var(--gray-light)); color: rgb(var(--gray-dark)); }
	.sidebar-footer { display: grid; gap: 2px; padding: 7px; border-top: 1px solid rgb(var(--gray-light)); }
	.sidebar-footer button { width: 100%; cursor: pointer; }
	.workspace-main { display: flex; min-height: 0; flex-direction: column; }
	.studio-bar { position: relative; z-index: 10; display: flex; flex: none; align-items: center; justify-content: space-between; height: 46px; padding: 0 10px; border-bottom: 1px solid rgb(var(--gray-light)); background: var(--surface); }
	.document-breadcrumb, .studio-actions { display: flex; align-items: center; gap: 7px; min-width: 0; }
	.document-breadcrumb button { width: 28px; height: 28px; padding: 0; border: 0; border-radius: 6px; background: transparent; color: rgb(var(--gray)); cursor: pointer; }
	.document-breadcrumb button:hover { background: var(--surface-soft); color: rgb(var(--gray-dark)); }
	.breadcrumb-workspace, .breadcrumb-separator { color: rgb(var(--gray)); font-size: 11px; }
	.document-breadcrumb strong { max-width: 340px; overflow: hidden; color: rgb(var(--gray-dark)); font-size: 11px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
	.studio-actions a, .studio-actions button { padding: 5px 9px; border: 1px solid rgb(var(--gray-light)); border-radius: 6px; background: var(--surface); color: rgb(var(--gray-dark)); font: inherit; font-size: 11px; text-decoration: none; cursor: pointer; }
	.studio-actions button { border-color: var(--accent); background: var(--accent); color: var(--on-accent); }
	.studio-actions button.icon-action { width: 28px; height: 28px; padding: 0; border: 0; background: transparent; color: rgb(var(--gray)); font-size: 15px; }
	.studio-actions button.icon-action:hover { background: var(--surface-soft); color: rgb(var(--gray-dark)); }
	.studio-actions button.icon-action[aria-pressed='true'] { color: var(--accent); }
	.studio-actions button:disabled { opacity: 0.5; cursor: default; }
	.edited-at { color: rgb(var(--gray)); font-size: 10px; white-space: nowrap; opacity: 0.85; }
	/* 全宽: the page as wide as the editor allows, as on the blog. */
	.editor-panel.is-wide .page-head, .editor-panel.is-wide :global(.crepe-host .milkdown .ProseMirror) { width: min(100%, 1180px); }
	.save-status { max-width: 230px; color: rgb(var(--gray)); font-size: 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.save-status[data-state='dirty'] { color: rgb(var(--gray)); }
	.save-status[data-state='error'] { color: #b42318; }
	.save-status[data-state='saved'] { color: rgb(var(--gray)); }
	.panel-label { display: none; }
	.panel-label { color: rgb(var(--gray)); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; letter-spacing: 0.04em; }
	#article-list { flex: 1; padding: 1px 7px 32px; overflow-y: auto; }
	#article-list :global(.page-list) { display: grid; gap: 1px; }
	#article-list :global(.page-row) { display: grid; grid-template-columns: 19px minmax(0, 1fr) auto auto; align-items: center; gap: 6px; width: 100%; min-height: 31px; padding: 0 8px; border: 0; border-radius: 6px; background: transparent; color: rgb(var(--gray-dark)); font: inherit; text-align: left; cursor: pointer; }
	#article-list :global(.page-row:hover), #article-list :global(.page-row.active) { background: rgb(var(--gray-light)); }
	/* ⋯ on hover, over the badges at the end of the row. */
	#article-list :global(.page-item) { position: relative; }
	#article-list :global(.page-more) { position: absolute; top: 50%; right: 4px; width: 24px; height: 22px; padding: 0; border: 0; border-radius: 4px; background: rgb(var(--gray-light)); color: rgb(var(--gray)); font: inherit; font-size: 14px; line-height: 22px; cursor: pointer; opacity: 0; transform: translateY(-50%); }
	#article-list :global(.page-item:hover .page-more), #article-list :global(.page-more:focus-visible) { opacity: 1; }
	#article-list :global(.page-more:hover) { background: rgba(55, 53, 47, 0.16); color: rgb(var(--gray-dark)); }
	#article-list :global(.page-icon) { color: rgb(var(--gray)); font-size: 12px; text-align: center; }
	#article-list :global(.page-git) { font-size: 8px; line-height: 1; }
	#article-list :global(.page-git.is-modified) { color: rgb(var(--gray)); }
	#article-list :global(.page-git.is-new) { color: rgb(var(--gray)); }
	#article-list :global(.page-icon.is-emoji) { font-size: 14px; line-height: 1; text-align: center; }
	#article-list :global(.page-title) { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; font-weight: 500; }
	#article-list :global(.page-row.active .page-title) { color: rgb(var(--black)); font-weight: 650; }
	#article-list :global(.page-draft) { padding: 1px 4px; border-radius: 4px; color: rgb(var(--gray)); font-size: 8px; opacity: 0.82; }
	#article-list :global(.article-list-empty) { margin: 28px 12px; color: rgb(var(--gray)); font-size: 12px; line-height: 1.6; text-align: center; }
	.editor-panel { position: relative; display: flex; flex: 1; min-height: 0; flex-direction: column; }
	/* The outline at the editor's right edge, as on the blog. */
	.outline-rail { position: absolute; z-index: 12; top: 96px; right: 6px; display: flex; align-items: flex-start; pointer-events: none; }
	.outline-rail[hidden] { display: none; }
	.outline-pop { width: 220px; max-height: min(68vh, 520px); margin-right: 2px; overflow: auto; border-radius: 8px; background: var(--surface); box-shadow: 0 6px 24px rgba(15, 15, 15, 0.1); opacity: 0; pointer-events: none; transition: opacity 120ms ease; }
	.outline-rail:hover .outline-pop, .outline-rail:focus-within .outline-pop { opacity: 1; pointer-events: auto; }
	.outline-pop ol { display: grid; gap: 1px; margin: 0; padding: 4px; list-style: none; }
	.outline-pop :global(a) { display: block; padding: 3px 8px; border-radius: 4px; color: rgb(var(--gray)); font-size: 13px; line-height: 1.35; text-align: right; text-decoration: none; }
	.outline-pop :global(li.child a) { font-size: 12px; }
	.outline-pop :global(a:hover) { background: var(--surface-hover); color: rgb(var(--black)); }
	.outline-pop :global(a[aria-current]) { color: rgb(var(--black)); font-weight: 600; }
	.outline-marks { display: grid; justify-items: end; gap: 10px; width: 22px; padding: 8px 2px; pointer-events: auto; }
	.outline-marks :global(i) { display: block; width: 14px; height: 1px; border-radius: 1px; background: rgb(var(--gray)); opacity: 0.55; }
	.outline-marks :global(i.child) { width: 8px; }
	.outline-marks :global(i[data-current]) { height: 2px; background: rgb(var(--gray-dark)); opacity: 1; }
	.panel-label > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	#roundtrip-status { margin-left: 14px; color: rgb(var(--gray)); font-size: 9px; }
	#roundtrip-status[data-state='changed'] { color: #b42318; }
	#roundtrip-status[data-state='exact'] { color: rgb(var(--gray)); }
	.editor-scroll { position: relative; flex: 1; min-height: 0; overflow-y: auto; background: var(--surface); }
	.review-bar { display: flex; flex: none; align-items: center; gap: 10px; padding: 8px 20px; border-bottom: 1px solid color-mix(in srgb, var(--accent) 25%, rgb(var(--gray-light))); background: color-mix(in srgb, var(--accent) 7%, var(--surface)); font-size: 13px; }
	.review-bar[hidden] { display: none; }
	.review-bar #review-count { font-weight: 700; }
	.review-bar .review-hint { flex: 1; min-width: 0; overflow: hidden; color: rgb(var(--gray)); font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
	.review-bar button { padding: 4px 12px; border: 1px solid rgb(var(--gray-light)); border-radius: 6px; background: var(--surface); color: inherit; font: inherit; cursor: pointer; }
	.review-bar button.review-accept { border-color: var(--accent); background: var(--accent); color: var(--on-accent); font-weight: 700; }
	.document-header { box-sizing: border-box; width: 100%; background: transparent; }
	.page-head { box-sizing: border-box; position: relative; width: min(100%, 850px); margin: 0 auto; padding: 52px 58px 0; }
	.document-header.has-cover .page-head { padding-top: 22px; }
	.document-header.has-cover.has-icon .page-head { padding-top: 0; }
	/* The cover spans the page, as on the blog. */
	.page-cover { position: relative; height: 30vh; max-height: 280px; min-height: 160px; overflow: hidden; background: var(--surface-soft); }
	.page-cover[hidden] { display: none; }
	.page-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
