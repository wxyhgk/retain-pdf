---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={`Studio · ${SITE_TITLE}`} description="本地文章工作台" /></head>
	<body class="studio-body">
		<main class="studio-shell">
			<aside class="article-sidebar">
				<div class="workspace-heading">
					<a href="/" class="workspace-identity"><span class="workspace-avatar">C</span><strong>{SITE_TITLE}</strong></a>
					<span class="studio-badge">Studio</span>
				</div>
				<div class="workspace-navigation">
					<a href="/"><span>⌂</span>首页</a>
					<label class="article-search"><span>⌕</span><input id="article-search" type="search" placeholder="搜索文章" aria-label="搜索文章" /></label>
				</div>
				<div class="panel-heading"><h1>Private</h1><button id="new-article" type="button" title="新建文章" aria-label="新建文章">＋</button></div>
				<nav id="article-list" aria-label="页面列表"></nav>
				<div class="sidebar-footer">
					<button id="new-article-secondary" type="button"><span>＋</span>新建文章</button>
					<a href="/blog/"><span>◫</span>博客首页</a>
					<div class="sidebar-placeholder"><span>⚙</span>设置<small>稍后</small></div>
					<div class="sidebar-placeholder"><span>♲</span>回收站<small>稍后</small></div>
				</div>
			</aside>

			<section class="workspace-main">
				<header class="studio-bar">
					<div class="document-breadcrumb">
						<button id="toggle-sidebar" type="button" aria-label="收起侧边栏" aria-pressed="false">◧</button>
						<span class="breadcrumb-workspace">{SITE_TITLE}</span><span class="breadcrumb-separator">/</span><strong id="breadcrumb-title">选择一篇文章</strong>
					</div>
					<div class="studio-actions">
						<span id="save-status" class="save-status">正在连接…</span>
						<a id="open-article" href="/blog" target="_blank">打开博客</a>
						<button id="toggle-side-panel" class="icon-action" type="button" aria-pressed="true" aria-label="收起右侧面板" title="文件与终端">◨</button>
						<button id="save-button" type="button" disabled>保存</button>
					</div>
				</header>

				<section class="editor-panel" aria-label="文章编辑器">
					<div class="panel-label">
						<span id="editor-path">选择一篇文章</span>
						<span id="roundtrip-status">等待载入</span>
					</div>
					<div class="editor-scroll">
					<header class="document-header">
						<input id="article-title-input" class="article-title-input" type="text" aria-label="文章标题" placeholder="无标题" disabled />
						<div class="document-property-bar">
							<button id="toggle-properties" type="button" aria-expanded="false">☷ 属性</button>
							<span id="property-summary">尚未载入属性</span>
							<button id="publish-article" class="publish-action" type="button" disabled>发布</button>
						</div>
						<div id="article-properties" class="article-properties" hidden>
							<label class="description-property"><span>描述</span><textarea id="article-description" rows="2" placeholder="这篇文章讲了什么？" disabled></textarea></label>
							<label><span>标签</span><input id="article-tags" type="text" placeholder="Hartree–Fock, 量子化学" disabled /><small>使用逗号分隔</small></label>
							<label><span>发布日期</span><input id="article-pub-date" type="date" disabled /></label>
							<label class="draft-property"><span>草稿</span><input id="article-draft" type="checkbox" disabled /></label>
							<p id="property-error" role="alert" hidden></p>
						</div>
					</header>
					<div id="crepe-editor" class="crepe-host" aria-label="文章编辑器"></div>
					</div>
				</section>
			</section>

			<aside id="side-panel" class="side-panel" aria-label="文件与终端">
				<div class="side-panel-resizer" role="separator" aria-orientation="vertical" aria-label="调整面板宽度" tabindex="0" title="拖动调整宽度，双击恢复"></div>
				<div class="side-tabs" role="tablist" aria-label="右侧面板">
					<button id="side-tab-files" role="tab" type="button" aria-controls="side-files" aria-selected="true">文件</button>
					<button id="side-tab-terminal" role="tab" type="button" aria-controls="side-terminal" aria-selected="false">终端</button>
					<button id="close-side-panel" class="side-close" type="button" aria-label="收起右侧面板">×</button>
				</div>
				<section id="side-files" class="side-pane" role="tabpanel" aria-labelledby="side-tab-files">
					<header class="pane-toolbar">
						<span id="files-root" class="pane-path">未打开文章</span>
						<div class="pane-actions">
							<button id="upload-files" type="button" title="上传文件；文件和整个文件夹也可以直接拖进来" aria-label="上传文件" disabled>⤒</button>
							<button id="new-folder" type="button" title="新建文件夹" aria-label="新建文件夹" disabled>＋</button>
							<button id="refresh-files" type="button" title="重新读取文件夹" aria-label="刷新" disabled>↻</button>
						</div>
						<input id="file-upload-input" type="file" multiple hidden />
					</header>
					<div id="file-tree" class="file-tree"></div>
					<p id="files-status" class="files-status" role="status" aria-live="polite"></p>
				</section>
				<section id="side-terminal" class="side-pane" role="tabpanel" aria-labelledby="side-tab-terminal" hidden>
					<header class="pane-toolbar">
						<div class="cwd-switch" role="radiogroup" aria-label="终端启动目录">
							<button type="button" role="radio" data-cwd="root" aria-checked="true">仓库根目录</button>
							<button type="button" role="radio" data-cwd="article" aria-checked="false">当前文章</button>
						</div>
					</header>
					<div class="terminal-screen" aria-label="终端">
						<p><span class="terminal-prompt">~</span> <span id="terminal-cwd">仓库根目录</span></p>
						<p class="terminal-hint">终端即将接入。接入后可在这里运行 <code>claude</code> 等命令，改动会同步到编辑器。</p>
					</div>
				</section>
			</aside>
		</main>

		<dialog id="new-article-dialog" class="article-dialog">
			<form id="new-article-form">
				<div class="dialog-heading">
					<div><strong>新建文章</strong><span>创建一个完整的文章文件夹</span></div>
					<button id="cancel-new-article" type="button" aria-label="关闭">×</button>
				</div>
				<label>
					<span>标题</span>
					<input id="new-article-title" name="title" type="text" autocomplete="off" placeholder="例如：Hartree–Fock 学习笔记" required />
				</label>
				<label>
					<span>文件夹名称</span>
					<div class="slug-field"><span>blog/</span><input id="new-article-slug" name="slug" type="text" autocomplete="off" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" required /><span>/</span></div>
					<small>只能使用小写字母、数字和连字符，创建后暂不支持修改。</small>
				</label>
				<p id="new-article-error" class="dialog-error" role="alert" hidden></p>
				<div class="dialog-actions">
					<button id="cancel-new-article-secondary" type="button">取消</button>
					<button id="create-article" type="submit">创建并打开</button>
				</div>
			</form>
		</dialog>

		<script>import './main';</script>
	</body>
</html>

<style>
	:global(body.studio-body) { height: 100vh; overflow: hidden; font-size: 16px; }
	.studio-shell { --sidebar: 250px; --panel: var(--panel-width, 340px); display: grid; grid-template-columns: var(--sidebar) minmax(0, 1fr) var(--panel); width: 100%; max-width: none; height: 100vh; margin: 0; padding: 0; transition: grid-template-columns 180ms ease; }
	.studio-shell.sidebar-collapsed { --sidebar: 0px; }
	.studio-shell.panel-collapsed { --panel: 0px; }
	.studio-shell.is-resizing { transition: none; cursor: col-resize; user-select: none; }
	.article-sidebar, .workspace-main, .editor-panel, .side-panel { min-width: 0; overflow: hidden; background: var(--surface); }
	.article-sidebar { display: flex; flex-direction: column; border-right: 1px solid rgb(var(--gray-light)); background: var(--surface-soft); transition: opacity 120ms ease; }
	.studio-shell.sidebar-collapsed .article-sidebar { opacity: 0; pointer-events: none; }
	.workspace-heading { display: flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 11px; }
	.workspace-identity { display: flex; flex: 1; align-items: center; gap: 8px; min-width: 0; color: rgb(var(--gray-dark)); text-decoration: none; }
	.workspace-avatar { display: grid; flex: none; width: 23px; height: 23px; place-items: center; border-radius: 5px; background: var(--accent); color: white; font-size: 11px; font-weight: 800; }
	.workspace-identity strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; }
	.studio-badge { padding: 2px 5px; border-radius: 4px; background: rgb(var(--gray-light)); color: rgb(var(--gray)); font-size: 8px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
	.workspace-navigation { display: grid; gap: 2px; padding: 4px 7px 9px; }
	.workspace-navigation a, .article-search, .sidebar-footer a, .sidebar-footer button, .sidebar-placeholder { display: flex; align-items: center; gap: 9px; min-height: 31px; padding: 0 8px; border: 0; border-radius: 6px; background: transparent; color: rgb(var(--gray-dark)); font: inherit; font-size: 12px; text-align: left; text-decoration: none; }
	.workspace-navigation a:hover, .article-search:focus-within, .sidebar-footer a:hover, .sidebar-footer button:hover { background: rgb(var(--gray-light)); }
	.workspace-navigation a > span, .article-search > span, .sidebar-footer > * > span { width: 15px; color: rgb(var(--gray)); text-align: center; }
	.article-search input { min-width: 0; flex: 1; border: 0; background: transparent; color: rgb(var(--gray-dark)); font: inherit; font-size: 12px; outline: none; }
	.article-search input::placeholder { color: rgb(var(--gray)); opacity: 1; }
	.panel-heading { display: flex; align-items: center; justify-content: space-between; min-height: 31px; padding: 0 11px 0 15px; }
	.panel-heading h1 { margin: 0; color: rgb(var(--gray)); font-size: 10px; font-weight: 700; letter-spacing: 0.04em; }
	.panel-heading button { width: 23px; height: 23px; border: 0; border-radius: 5px; background: transparent; color: rgb(var(--gray)); font-size: 17px; cursor: pointer; }
	.panel-heading button:hover { background: rgb(var(--gray-light)); color: rgb(var(--gray-dark)); }
	.sidebar-footer { display: grid; gap: 2px; padding: 7px; border-top: 1px solid rgb(var(--gray-light)); }
	.sidebar-footer button { width: 100%; cursor: pointer; }
	.sidebar-placeholder { color: rgb(var(--gray)); cursor: default; }
	.sidebar-placeholder small { margin-left: auto; font-size: 8px; opacity: 0.65; }
	.workspace-main { display: flex; min-height: 0; flex-direction: column; }
	.studio-bar { position: relative; z-index: 10; display: flex; flex: none; align-items: center; justify-content: space-between; height: 46px; padding: 0 10px; border-bottom: 1px solid rgb(var(--gray-light)); background: var(--surface); }
	.document-breadcrumb, .studio-actions { display: flex; align-items: center; gap: 7px; min-width: 0; }
	.document-breadcrumb button { width: 28px; height: 28px; padding: 0; border: 0; border-radius: 6px; background: transparent; color: rgb(var(--gray)); cursor: pointer; }
	.document-breadcrumb button:hover { background: var(--surface-soft); color: rgb(var(--gray-dark)); }
	.breadcrumb-workspace, .breadcrumb-separator { color: rgb(var(--gray)); font-size: 11px; }
	.document-breadcrumb strong { max-width: 340px; overflow: hidden; color: rgb(var(--gray-dark)); font-size: 11px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
	.studio-actions a, .studio-actions button { padding: 5px 9px; border: 1px solid rgb(var(--gray-light)); border-radius: 6px; background: var(--surface); color: rgb(var(--gray-dark)); font: inherit; font-size: 11px; text-decoration: none; cursor: pointer; }
	.studio-actions button { border-color: var(--accent); background: var(--accent); color: white; }
	.studio-actions button.icon-action { width: 28px; height: 28px; padding: 0; border: 0; background: transparent; color: rgb(var(--gray)); font-size: 15px; }
	.studio-actions button.icon-action:hover { background: var(--surface-soft); color: rgb(var(--gray-dark)); }
	.studio-actions button.icon-action[aria-pressed='true'] { color: var(--accent); }
	.studio-actions button:disabled { opacity: 0.5; cursor: default; }
	.save-status { max-width: 230px; color: rgb(var(--gray)); font-size: 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.save-status[data-state='dirty'] { color: #a15c00; }
	.save-status[data-state='error'] { color: #b42318; }
	.save-status[data-state='saved'] { color: var(--accent); }
	.panel-label { display: none; }
	.panel-label { color: rgb(var(--gray)); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; letter-spacing: 0.04em; }
	#article-list { flex: 1; padding: 1px 7px 32px; overflow-y: auto; }
	#article-list :global(.page-list) { display: grid; gap: 1px; }
	#article-list :global(.page-row) { display: grid; grid-template-columns: 19px minmax(0, 1fr) auto; align-items: center; gap: 6px; width: 100%; min-height: 31px; padding: 0 8px; border: 0; border-radius: 6px; background: transparent; color: rgb(var(--gray-dark)); font: inherit; text-align: left; cursor: pointer; }
	#article-list :global(.page-row:hover), #article-list :global(.page-row.active) { background: rgb(var(--gray-light)); }
	#article-list :global(.page-icon) { color: rgb(var(--gray)); font-size: 12px; text-align: center; }
	#article-list :global(.page-title) { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; font-weight: 500; }
	#article-list :global(.page-row.active .page-title) { color: rgb(var(--black)); font-weight: 650; }
	#article-list :global(.page-draft) { padding: 1px 4px; border-radius: 4px; color: #9a6100; font-size: 8px; opacity: 0.82; }
	#article-list :global(.article-list-empty) { margin: 28px 12px; color: rgb(var(--gray)); font-size: 12px; line-height: 1.6; text-align: center; }
	.editor-panel { display: flex; flex: 1; min-height: 0; flex-direction: column; }
	.panel-label > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	#roundtrip-status { margin-left: 14px; color: rgb(var(--gray)); font-size: 9px; }
	#roundtrip-status[data-state='changed'] { color: #b42318; }
	#roundtrip-status[data-state='exact'] { color: #18794e; }
	.editor-scroll { flex: 1; min-height: 0; overflow-y: auto; background: var(--surface); }
	.document-header { box-sizing: border-box; width: min(100%, 850px); margin: 0 auto; padding: 52px 58px 0; background: transparent; }
	.article-title-input { box-sizing: border-box; width: 100%; padding: 0; border: 0; background: transparent; color: rgb(var(--black)); font-family: var(--font-atkinson), system-ui, sans-serif; font-size: clamp(30px, 3vw, 42px); font-weight: 700; letter-spacing: -0.025em; line-height: 1.18; outline: none; }
	.article-title-input::placeholder { color: rgb(var(--gray)); opacity: 0.48; }
	.article-title-input:disabled { opacity: 0.55; }
	.document-property-bar { display: flex; align-items: center; gap: 9px; min-height: 34px; margin-top: 9px; color: rgb(var(--gray)); font-size: 10px; }
	.document-property-bar button { padding: 4px 8px; border: 0; border-radius: 5px; background: transparent; color: rgb(var(--gray)); font: inherit; cursor: pointer; }
	.document-property-bar button:hover { background: var(--surface-soft); color: rgb(var(--gray-dark)); }
	.document-property-bar #property-summary { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.document-property-bar button.publish-action { border: 1px solid color-mix(in srgb, var(--accent) 30%, rgb(var(--gray-light))); background: color-mix(in srgb, var(--accent) 8%, var(--surface)); color: var(--accent); font-weight: 700; }
	.document-property-bar button.publish-action[data-published='true'] { border-color: rgb(var(--gray-light)); background: var(--surface); color: rgb(var(--gray)); }
	.document-property-bar button:disabled { opacity: 0.45; cursor: default; }
	.article-properties { display: grid; grid-template-columns: minmax(0, 2fr) minmax(150px, 1fr) 150px 80px; gap: 12px; margin-top: 10px; padding: 14px; border: 1px solid rgb(var(--gray-light)); border-radius: 9px; background: var(--surface-soft); }
	.article-properties[hidden] { display: none; }
	.article-properties label { display: flex; min-width: 0; flex-direction: column; gap: 5px; color: rgb(var(--gray)); font-size: 9px; }
	.article-properties input, .article-properties textarea { box-sizing: border-box; width: 100%; min-height: 32px; padding: 6px 8px; border: 1px solid rgb(var(--gray-light)); border-radius: 6px; background: var(--surface); color: rgb(var(--gray-dark)); font: inherit; font-size: 11px; outline: none; resize: vertical; }
	.article-properties input:focus, .article-properties textarea:focus { border-color: var(--accent); }
	.article-properties small { font-size: 8px; opacity: 0.8; }
	.article-properties .draft-property { align-items: center; justify-content: center; }
	.article-properties .draft-property input { width: 16px; min-height: 16px; accent-color: var(--accent); }
	#property-error { grid-column: 1 / -1; margin: 0; color: #b42318; font-size: 10px; }
	.crepe-host { min-height: calc(100vh - 210px); background: transparent; }
	:global(.crepe-host .milkdown) {
		--crepe-color-background: var(--surface);
		--crepe-color-on-background: rgb(var(--gray-dark));
		--crepe-color-surface: var(--surface);
		--crepe-color-surface-low: var(--surface-soft);
		--crepe-color-on-surface: rgb(var(--gray-dark));
		--crepe-color-on-surface-variant: rgb(var(--gray));
		--crepe-color-outline: rgb(var(--gray));
		--crepe-color-primary: var(--accent);
		--crepe-color-secondary: color-mix(in srgb, var(--accent) 12%, var(--surface));
		--crepe-color-on-secondary: var(--accent);
		--crepe-color-hover: var(--surface-soft);
		--crepe-color-selected: color-mix(in srgb, var(--accent) 16%, var(--surface));
		--crepe-color-inline-area: rgb(var(--gray-light));
		--crepe-font-title: var(--font-atkinson), system-ui, sans-serif;
		--crepe-font-default: var(--font-atkinson), system-ui, sans-serif;
		min-height: 100%;
	}
	:global(.crepe-host .milkdown .ProseMirror) { box-sizing: border-box; width: min(100%, 850px); min-height: 100%; margin: 0 auto; padding: 10px 58px 180px; color: rgb(var(--gray-dark)); font-size: 17px; line-height: 1.72; }
	:global(.crepe-host .milkdown .ProseMirror h1) { font-size: 1.7em; font-weight: 700; letter-spacing: -0.02em; line-height: 1.25; margin: 1.05em 0 0.1em; }
	:global(.crepe-host .milkdown .ProseMirror h2) { font-size: 1.35em; font-weight: 700; line-height: 1.3; margin: 0.95em 0 0.08em; }
	:global(.crepe-host .milkdown .ProseMirror h3) { font-size: 1.12em; font-weight: 650; line-height: 1.35; margin: 0.8em 0 0.06em; }
	:global(.crepe-host .milkdown .ProseMirror h1:first-child),
	:global(.crepe-host .milkdown .ProseMirror h2:first-child),
	:global(.crepe-host .milkdown .ProseMirror h3:first-child) { margin-top: 0.15em; }
	:global(.crepe-host .milkdown .ProseMirror p) { margin: 0; padding: 2px 0; line-height: 1.65; }
	:global(.crepe-host .milkdown .ProseMirror.ProseMirror-hideselection),
	:global(.crepe-host .milkdown .ProseMirror.ProseMirror-hideselection * ) { caret-color: transparent; }
	:global(.crepe-host .milkdown .ProseMirror.ProseMirror-hideselection *::selection) { background: transparent; }
	:global(.crepe-host .milkdown .ProseMirror.ProseMirror-hideselection *::-moz-selection) { background: transparent; }
	:global(.crepe-host .milkdown .ProseMirror .pm-block-range) { border-radius: 3px; background: color-mix(in srgb, var(--accent) 18%, var(--surface)); }
	.editor-scroll.pm-block-dragging,
	.editor-scroll.pm-block-dragging :global(.ProseMirror) { user-select: none; }
	:global(.crepe-host .milkdown .ProseMirror .pm-math-source) { color: #9a9a9a; background: none; }
	:global(.crepe-host .milkdown .ProseMirror .pm-math-cmd) { color: #c45cdb; }
	:global(.crepe-host .milkdown .ProseMirror .pm-math-preview) { position: relative; display: inline-block; width: 0; height: 0; vertical-align: baseline; pointer-events: none; user-select: none; z-index: 40; }
	:global(.crepe-host .milkdown .ProseMirror .pm-math-preview-body) { position: absolute; top: 14px; left: 0; padding: 7px 12px 8px; border-radius: 7px; background: #1c1c1c; color: #fff; white-space: nowrap; box-shadow: 0 8px 18px rgb(0 0 0 / 16%); }
	:global(.crepe-host .milkdown .ProseMirror .pm-math-preview-body::before) { content: ''; position: absolute; top: -6px; left: var(--arrow, 16px); transform: translateX(-50%); border-width: 0 6px 6px; border-style: solid; border-color: transparent transparent #1c1c1c; }
	:global(.crepe-host .milkdown .ProseMirror .pm-math-preview-body .katex) { color: inherit; font-size: 1.12em; }
	:global(html[data-theme='dark'] .crepe-host .milkdown .ProseMirror .pm-math-source) { color: #b5b5b5; }
	:global(html[data-theme='dark'] .crepe-host .milkdown .ProseMirror .pm-math-cmd) { color: #e48cf0; }
	:global(html[data-theme='dark'] .crepe-host .milkdown .ProseMirror .pm-math-preview-body) { background: #f3f3f3; color: #191919; }
	:global(html[data-theme='dark'] .crepe-host .milkdown .ProseMirror .pm-math-preview-body::before) { border-color: transparent transparent #f3f3f3; }
	:global(.crepe-host .milkdown .ProseMirror .pm-inline-math) { display: inline-block; vertical-align: middle; margin: 0 1px; padding-inline: 0.2em; line-height: 1; color: inherit; cursor: text; user-select: none; }
	:global(.crepe-host .milkdown .ProseMirror .pm-inline-math .katex-mathml) { display: none; }
	:global(.crepe-host .milkdown .ProseMirror .pm-inline-math:hover),
	:global(.crepe-host .milkdown .ProseMirror .pm-inline-math.is-editing) { border-radius: 4px; background: color-mix(in srgb, var(--accent) 14%, var(--surface)); }
