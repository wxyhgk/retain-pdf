---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';
import { ArticleRepository } from './server/articles/article-repository.mjs';
import { pageVersion, studioBlogRoot } from './server/articles/page-version.mjs';
import { LocaleSettings, studioSettingsFile } from './server/locale-settings.mjs';
import { setLocale, t } from '@blog/i18n/index.mjs';
import { askedLocales } from '@blog/i18n/server.mjs';
import { SideTabs } from './shell/SideTabs';
import { Sidebar } from './shell/Sidebar';
import { TopBar } from './shell/TopBar';
import { createHeaderState } from './pages/header/header-state';
import { PageHeader } from './pages/header/PageHeader';
import { createFilePanelState } from './files/panel/file-panel-state';
import { FilePanel } from './files/panel/FilePanel';
import { RotateCw } from 'lucide-react';
// The editor's styles in the page itself, not added by its scripts later, so the first picture is drawn as the editor draws it.
import '@milkdown/crepe/theme/common/style.css';
import '@milkdown/crepe/theme/classic.css';
import '@blog/editor-kit/math/math.css';
import '@blog/markdown/callouts/callouts.css';
import '@blog/markdown/code-files/code-files.css';
import '@blog/markdown/figures/figures.css';
import '@blog/markdown/references/references.css';
import '@blog/office/office.css';
import '@xterm/xterm/css/xterm.css';
import './tokens.css';
import '@fontsource-variable/inter/opsz.css';
import './design.css';
import './shell/shell.css';
import './pages/page-header.css';
import './files/file-panel.css';
import './shell/sidebar-hosts.css';
import './files/drive.css';
import './pages/article-table.css';
import './ai/ai-panel.css';
import '@blog/ui/block-sheet.css';
// KaTeX draws nothing until its fonts are in: the ones most formulas use, asked for with the page.
import katexMain from 'katex/dist/fonts/KaTeX_Main-Regular.woff2?url';
import katexMath from 'katex/dist/fonts/KaTeX_Math-Italic.woff2?url';
import katexSize1 from 'katex/dist/fonts/KaTeX_Size1-Regular.woff2?url';
import katexSize2 from 'katex/dist/fonts/KaTeX_Size2-Regular.woff2?url';
import katexAms from 'katex/dist/fonts/KaTeX_AMS-Regular.woff2?url';

// The mark of what the page shows with each article open (page-snapshot.ts); the
// address, which picks the article, is the browser's to read.
// The language the Studio speaks (its setting, or the browser's): what the server draws is in it, and the page goes on in it.
const spoken = await new LocaleSettings(studioSettingsFile(process.cwd())).spoken(askedLocales(Astro.request.headers.get('accept-language')));
setLocale(spoken);
const blogRoot = studioBlogRoot(process.cwd());
const articles = await new ArticleRepository(blogRoot).list().catch(() => []);
// The page header as it is before an article is shown (its fields waiting); the page's script draws it from then on.
const header = createHeaderState({ changed: () => null, mayPublish: async () => false, publish() {}, leaveTitle() {}, fileUrl: (src) => src, pictures: async () => [], upload: async () => '' });
// The 文件 tab as it is with no article open; the page's script draws it from then on.
const files = createFilePanelState({ source: () => '', revision: () => '', settle: async () => {}, moved: async () => {}, insertMarkdown() {}, viewOffice() {}, sheetRows: async () => [], ocr() {} });
const pages = { first: articles[0]?.slug ?? null, versions: Object.fromEntries(await Promise.all(articles.map(async ({ slug }) => [slug, await pageVersion(blogRoot, slug)]))) };
---

<!doctype html>
<html lang={spoken} data-studio-locale={spoken}>
	<head>
		<BaseHead title={`Studio · ${SITE_TITLE}`} description={t('本地文章工作台')} />
		{[katexMain, katexMath, katexSize1, katexSize2, katexAms].map((font) => <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />)}
		<!-- React's fast refresh for the shell (shell/), before its components load: what @astrojs/react puts in a page with islands only. -->
		<script is:inline type="module">
			import { injectIntoGlobalHook } from '/@react-refresh';
			injectIntoGlobalHook(window);
			window.$RefreshReg$ = () => {};
			window.$RefreshSig$ = () => (type) => type;
		</script>
	</head>
	<body class="studio-body" style={{ '--word-current': JSON.stringify(t('当前')), '--word-drop-files': JSON.stringify(t('拖入文件即可上传 · 右键查看更多操作')), '--word-instructing': JSON.stringify(t('AI 处理中…')) }}>
		<main class="studio-shell">
			<!-- The shell, drawn by React (shell/): here as the server draws it, then by the page's script (mount.tsx). -->
			<aside class="article-sidebar" data-ui><Sidebar siteTitle={SITE_TITLE} /></aside>

			<section class="workspace-main">
				<header class="studio-bar" data-ui><TopBar siteTitle={SITE_TITLE} /></header>

				<section class="editor-panel" aria-label={t('文章编辑器')}>
					<div class="panel-label">
						<span id="editor-path">{t('选择一篇文章')}</span>
						<span id="roundtrip-status">{t('等待载入')}</span>
					</div>
					<div id="review-bar" class="review-bar" role="status" hidden>
						<span id="review-count"></span>
						<span id="review-hint" class="review-hint">{t('已经保存在磁盘上；拒绝的会改回去')}</span>
						<button id="review-retry" type="button" hidden>{t('重试')}</button>
						<button id="review-reject-all" type="button">{t('全部拒绝')}</button>
						<button id="review-accept-all" type="button" class="review-accept">{t('全部接受')}</button>
					</div>
					<div class="editor-scroll">
					<!-- The cover, the icon, the title, the properties: drawn by React (pages/header/), here as the server draws it. -->
					<header class="document-header"><PageHeader store={header.store} actions={header.actions} /></header>
					<div id="crepe-editor" class="crepe-host math-editor" aria-label={t('文章编辑器')}></div>
					</div>
					<nav id="editor-outline" class="outline-rail" aria-label={t('文章目录')} hidden>
						<div class="outline-pop"><ol></ol></div>
						<div class="outline-marks" aria-hidden="true"></div>
					</nav>
				</section>
				<section id="drive-view" class="drive-page" aria-label={t('资料库')} hidden></section>
				<section id="table-view" class="table-page" aria-label={t('全部文章')} hidden></section>
				<!-- AI 问答: the AI tab's panel, moved here whole (main.ts showChat). -->
				<section id="chat-view" class="chat-view" aria-label={t('AI 问答')} hidden></section>
			</section>

			<aside id="side-panel" class="side-panel" aria-label={t('AI、文件与终端')}>
				<div class="side-panel-resizer" role="separator" aria-orientation="vertical" aria-label={t('调整面板宽度')} tabindex="0" title={t('拖动调整宽度，双击恢复')}></div>
				<div class="side-tabs" role="tablist" aria-label={t('右侧面板')} data-ui><SideTabs /></div>
				<!-- The AI (ai-panel.ts draws it). -->
				<section id="side-ai" class="side-pane ai-pane" role="tabpanel" aria-labelledby="side-tab-ai" hidden></section>
				<!-- The article's files: drawn by React (files/panel/), here as the server draws it. -->
				<section id="side-files" class="side-pane" role="tabpanel" aria-labelledby="side-tab-files"><FilePanel store={files.store} actions={files.actions} /></section>
				<section id="side-drive" class="side-pane" role="tabpanel" aria-labelledby="side-tab-drive" hidden></section>
				<section id="side-terminal" class="side-pane" role="tabpanel" aria-labelledby="side-tab-terminal" hidden>
					<header class="pane-toolbar">
						<div class="cwd-switch" role="radiogroup" aria-label={t('终端启动目录')}>
							<button type="button" role="radio" data-cwd="root" aria-checked="true">{t('仓库根目录')}</button>
							<button type="button" role="radio" data-cwd="article" aria-checked="false">{t('当前文章')}</button>
							<button type="button" role="radio" data-cwd="drive" aria-checked="false" title={t('先在左侧「资料库」里选好文件夹')}>{t('资料库')}</button>
						</div>
						<span id="terminal-cwd" class="pane-path"></span>
						<div class="pane-actions">
							<button id="restart-terminal" type="button" title={t('重新打开终端')} aria-label={t('重新打开终端')}><RotateCw aria-hidden="true" /></button>
						</div>
					</header>
					<div id="terminal-agents" class="terminal-agents" role="group" aria-label={t('在终端里启动 AI')} hidden></div>
					<div id="terminal-screen" class="terminal-screen" aria-label={t('终端')}></div>
				</section>
			</aside>
			<!-- The background tasks: an AI doing what a line asks, a PDF being read (task-tray.ts). -->
			<div id="task-tray" class="task-tray" aria-live="polite" hidden></div>
			<!-- The 小程序's floating windows (mini-apps.ts). -->
			<div id="mini-app-layer" class="mini-app-layer"></div>
		</main>
		<script is:inline define:vars={{ pages }}>
			// Before the editor loads: the right column as it was left, and the page as
			// it was left (page-snapshot.ts) over it while nothing it shows has changed.
			try {
				const shell = document.querySelector('.studio-shell');
				const layout = JSON.parse(localStorage.getItem('studio.side-panel') ?? 'null');
				if (layout?.open === false) shell.classList.add('panel-collapsed');
				if (typeof layout?.width === 'number') shell.style.setProperty('--panel-width', `${Math.min(720, Math.max(260, Math.round(layout.width)))}px`);
				// The article main.ts opens (wiring/pages.ts): the address's, the one open last, or the first.
				const address = new URLSearchParams(window.location.search);
				const last = localStorage.getItem('studio.lastArticle');
				const slug = Object.hasOwn(pages.versions, address.get('article')) ? address.get('article') : Object.hasOwn(pages.versions, last) ? last : pages.first;
				const kept = JSON.parse(localStorage.getItem('studio.snapshot') ?? 'null');
				if (slug && !address.has('drive') && !address.has('pages') && kept?.slug === slug && kept.version === pages.versions[slug] && kept.locale === document.documentElement.lang && !navigator.webdriver) {
					const template = document.createElement('template');
					template.innerHTML = kept.html;
					const picture = template.content.firstElementChild;
					picture.classList.add('studio-snapshot');
					picture.inert = true;
					picture.setAttribute('aria-hidden', 'true');
					shell.after(picture);
					// Should the editor never come, the page as it is.
					setTimeout(() => picture.remove(), 10000);
				}
			} catch {
				// Storage refused, or a picture from another version of the page (or in another language): it loads as it is.
			}
		</script>

		<!-- What the shell opens over the page: dialogs, menus, the message at the bottom (mount.tsx). -->
		<div id="ui-layer" data-ui></div>

		<script>import './main';</script>
	</body>
</html>

<style>
	:global(body.studio-body) { height: 100vh; overflow: hidden; font-size: 16px; }
	.studio-shell { --sidebar: var(--studio-sidebar-width); --panel: var(--panel-width, var(--studio-panel-width)); display: grid; grid-template-columns: var(--sidebar) minmax(0, 1fr) var(--panel); width: 100%; max-width: none; height: 100vh; margin: 0; padding: 0; transition: grid-template-columns 180ms ease; }
	.studio-shell.sidebar-collapsed { --sidebar: 0px; }
	/* The page as it was left, over the page while the editor loads (page-snapshot.ts); until then the page shows no empty fields. */
	.studio-shell.studio-snapshot { position: fixed; inset: 0; z-index: 30; }
	.studio-shell:not([data-ready]) .editor-scroll { visibility: hidden; }
	.studio-shell.panel-collapsed { --panel: 0px; }
	.studio-shell.is-resizing { transition: none; cursor: col-resize; user-select: none; }
	.article-sidebar, .workspace-main, .editor-panel, .side-panel { min-width: 0; overflow: hidden; background: var(--surface); }
	.article-sidebar { display: flex; flex-direction: column; border-right: 1px solid var(--studio-hairline); background: var(--studio-sidebar); transition: opacity 120ms ease; }
	.studio-shell.sidebar-collapsed .article-sidebar { opacity: 0; pointer-events: none; }
	.chat-view { display: flex; flex: 1; min-height: 0; flex-direction: column; background: var(--surface); }
	.chat-view[hidden] { display: none; }
	.workspace-main { display: flex; min-height: 0; flex-direction: column; }
	.studio-bar { position: relative; z-index: 10; display: flex; flex: none; align-items: center; justify-content: space-between; height: 48px; padding: 0 10px; border-bottom: 1px solid var(--studio-hairline); background: var(--surface); }
	/* 全宽: the page as wide as the editor allows, as on the blog. */
	.editor-panel.is-wide :global(.crepe-host .milkdown .ProseMirror) { width: min(100%, 1180px); }
	.panel-label { display: none; }
	.panel-label { color: rgb(var(--gray)); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.04em; }
	/* Chosen with ⌘ or ⇧ to move or delete together. */
	/* ⋯ on hover, over the badges at the end of the row. */
	/* The tree: each level 14px further in, the triangle that folds what is under a page left of it. */
	/* Dragged onto a page: under it. Below the pages: at the top. */
	/* Above or below a page: a line there, as far in as the page. */
	.editor-panel { position: relative; display: flex; flex: 1; min-height: 0; flex-direction: column; }
	/* The drive in the middle, the article kept open behind it; the bar keeps only the side panel's button. */
	.drive-page { display: flex; flex: 1; min-height: 0; flex-direction: column; padding: 28px clamp(20px, 5vw, 64px) 12px; }
	.drive-page[hidden] { display: none; }
	.studio-shell:is([data-view='drive'], [data-view='table'], [data-view='chat']) .editor-panel { display: none; }
	/*
	 * Scrollbars: thin, a rounded gray thumb on no track, darker under the pointer. The system's
	 * (WebKit's, in the Mac app) are bars of their own, light on a dark page.
	 */
	:global(*::-webkit-scrollbar) { width: 10px; height: 10px; }
	:global(*::-webkit-scrollbar-track), :global(*::-webkit-scrollbar-corner) { background: transparent; }
	:global(*::-webkit-scrollbar-thumb) { border: 3px solid transparent; border-radius: 999px; background: rgba(var(--gray), 0.3) padding-box; }
	:global(*::-webkit-scrollbar-thumb:hover) { background-color: rgba(var(--gray), 0.55); }

	/* The outline at the editor's right edge, as on the blog: clear of the editor's scrollbar. */
	.outline-rail { position: absolute; z-index: 12; top: 96px; right: 16px; display: flex; align-items: flex-start; pointer-events: none; }
	.outline-rail[hidden] { display: none; }
	.outline-pop { width: 220px; max-height: min(68vh, 520px); margin-right: 2px; overflow: auto; border-radius: 8px; background: var(--surface); box-shadow: var(--studio-shadow-pop); opacity: 0; pointer-events: none; transition: opacity 120ms ease; }
	.outline-rail:hover .outline-pop, .outline-rail:focus-within .outline-pop { opacity: 1; pointer-events: auto; }
	.outline-pop ol { display: grid; gap: 1px; margin: 0; padding: 4px; list-style: none; }
	.outline-pop :global(a) { display: block; padding: 3px 8px; border-radius: 4px; color: rgb(var(--gray)); font-size: 13px; line-height: 1.35; text-align: right; text-decoration: none; }
	.outline-pop :global(li.child a) { font-size: 12px; }
	.outline-pop :global(a:hover) { background: var(--surface-hover); color: rgb(var(--black)); }
	.outline-pop :global(a[aria-current]) { color: rgb(var(--black)); font-weight: 600; }
	/* A short line a heading, the lower levels shorter: their shape, not a ruler. The one the reader is in, dark. */
	.outline-marks { display: grid; justify-items: end; gap: 8px; width: 24px; padding: 8px 4px; pointer-events: auto; }
	.outline-marks :global(i) { display: block; width: 16px; height: 2px; border-radius: 2px; background: rgba(var(--gray), 0.32); transition: background-color 120ms ease; }
	.outline-marks :global(i.child) { width: 9px; }
	.outline-marks :global(i[data-current]) { background: rgb(var(--gray-dark)); }
	.outline-rail:hover .outline-marks :global(i:not([data-current])) { background: rgba(var(--gray), 0.5); }
	.panel-label > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	#roundtrip-status { margin-left: 14px; color: rgb(var(--gray)); font-size: 9px; }
	#roundtrip-status[data-state='changed'] { color: var(--danger); }
	#roundtrip-status[data-state='exact'] { color: rgb(var(--gray)); }
	.editor-scroll { position: relative; flex: 1; min-height: 0; overflow-y: auto; background: var(--surface); }
	.review-bar { display: flex; flex: none; align-items: center; gap: 10px; padding: 8px 20px; border-bottom: 1px solid color-mix(in srgb, var(--accent) 25%, rgb(var(--gray-light))); background: color-mix(in srgb, var(--accent) 7%, var(--surface)); font-size: 13px; }
	.review-bar[hidden] { display: none; }
	.review-bar #review-count { font-weight: 700; }
	.review-bar .review-hint { flex: 1; min-width: 0; overflow: hidden; color: rgb(var(--gray)); font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
	.review-bar button { padding: 4px 12px; border: 1px solid rgb(var(--gray-light)); border-radius: 6px; background: var(--surface); color: inherit; font: inherit; cursor: pointer; }
	.review-bar button.review-accept { border-color: var(--accent); background: var(--accent); color: var(--on-accent); font-weight: 700; }
	/* ⌘K: a box near the top, as in Notion. */
	/* Where a search took the author to, for a moment. */
	:global(.search-flash) { position: absolute; z-index: 1; border-radius: 4px; pointer-events: none; animation: search-flash 1.6s ease-out forwards; }
	@keyframes search-flash { from { background: rgba(var(--gray), 0.28); } to { background: transparent; } }
	/* Toggles: a triangle and a title, the blocks under them folded away or not. */
	:global(.crepe-host .toggle-block) { margin: 4px 0; }
	:global(.crepe-host .toggle-head) { display: flex; align-items: center; gap: 2px; }
	:global(.crepe-host .toggle-arrow) { width: 24px; height: 24px; flex: none; padding: 0; border: 0; border-radius: 4px; background: transparent; color: rgb(var(--gray)); font: inherit; font-size: 14px; line-height: 24px; cursor: pointer; transition: transform 120ms ease; transform: rotate(90deg); }
	:global(.crepe-host .toggle-block.is-folded > .toggle-head .toggle-arrow) { transform: none; }
	:global(.crepe-host .toggle-arrow:hover) { background: var(--surface-soft); }
	:global(.crepe-host .toggle-summary) { flex: 1; min-width: 0; padding: 2px 2px; border: 0; background: transparent; color: rgb(var(--gray-dark)); font: inherit; font-weight: 500; outline: none; }
	:global(.crepe-host .toggle-summary::placeholder) { color: rgb(var(--gray)); opacity: 0.6; }
	:global(.crepe-host .toggle-body) { padding-left: 26px; }
	:global(.crepe-host .toggle-block.is-folded > .toggle-body) { display: none; }
	/* Columns: side by side, as many as there are; nothing drawn around them, as in Notion. */
	:global(.crepe-host .milkdown .ProseMirror .columns-block) { position: relative; margin: 4px 0; }
	/* The gap holds the handle (＋ and ⠿) of a block in the column on its right, with room either side. */
	:global(.crepe-host .milkdown .ProseMirror .columns) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 56px; }
	/* ＋ at the right adds a column; shown while the pointer is over the columns. */
	:global(.crepe-host .milkdown .ProseMirror .columns-add) { position: absolute; top: 0; right: -30px; width: 22px; height: 22px; padding: 0; border: 0; border-radius: 4px; background: transparent; color: rgb(var(--gray)); font: inherit; font-size: 16px; line-height: 22px; cursor: pointer; opacity: 0; }
	:global(.crepe-host .milkdown .ProseMirror .columns-block:hover > .columns-add) { opacity: 1; }
	:global(.crepe-host .milkdown .ProseMirror .columns-add:hover) { background: var(--surface-soft); color: rgb(var(--gray-dark)); }
	/* The gap between two columns is dragged to share their width otherwise. */
	:global(.crepe-host .milkdown .ProseMirror .columns-block.is-over-gap > .columns) { cursor: col-resize; }
	:global(.crepe-host .milkdown:has(.columns-block.is-over-gap) .milkdown-block-handle) { opacity: 0 !important; pointer-events: none; }
	:global(.crepe-host .milkdown .ProseMirror .columns-resize-line) { position: absolute; top: 0; bottom: 0; width: 2px; border-radius: 1px; background: rgb(var(--gray-dark)); opacity: 0; pointer-events: none; }
	:global(.crepe-host .milkdown .ProseMirror .columns-block.is-over-gap > .columns-resize-line) { opacity: 0.2; }
	:global(.crepe-host .milkdown .ProseMirror .columns-block.is-resizing > .columns-resize-line) { opacity: 0.45; }
	/* A block dragged to the side of another: an upright line where it goes, instead of the one between blocks. */
	:global(.columns-drop-line) { position: fixed; z-index: 50; width: 3px; border-radius: 2px; background: rgb(var(--gray-dark)); opacity: 0.4; pointer-events: none; }
	/* The indicator shows itself with an inline style. */
	:global(.crepe-host .milkdown.columns-side-drop .crepe-drop-cursor) { display: none !important; }
	:global(.crepe-host .milkdown .ProseMirror .column) { min-width: 0; }
	:global(.crepe-host .milkdown .ProseMirror .column > :first-child) { margin-top: 0; }
	:global(.crepe-host .milkdown .ProseMirror .column > :last-child) { margin-bottom: 0; }
	.crepe-host { min-height: calc(100vh - 210px); background: transparent; }
	:global(.crepe-host .milkdown) {
		--crepe-color-background: var(--surface);
		--crepe-color-on-background: rgb(var(--gray-dark));
		--crepe-color-surface: var(--surface);
		--crepe-color-surface-low: var(--surface-soft);
		--crepe-color-on-surface: rgb(var(--gray-dark));
		--crepe-color-on-surface-variant: rgb(var(--gray));
		--crepe-color-outline: rgb(var(--gray));
		--crepe-color-primary: var(--accent);
		--crepe-color-secondary: color-mix(in srgb, var(--accent) 12%, var(--surface));
		--crepe-color-on-secondary: var(--accent);
		--crepe-color-hover: var(--surface-soft);
		--crepe-color-selected: color-mix(in srgb, var(--accent) 16%, var(--surface));
		--crepe-color-inline-area: rgb(var(--gray-light));
		--crepe-color-inline-code: rgb(var(--gray-dark));
		--crepe-font-title: var(--font-text);
		--crepe-font-default: var(--font-text);
		--crepe-shadow-1: var(--studio-shadow-sm);
		--crepe-shadow-2: var(--studio-shadow-pop);
		min-height: 100%;
	}
	:global(.crepe-host .milkdown .ProseMirror) { box-sizing: border-box; width: min(100%, var(--studio-editor-width)); min-height: 100%; margin: 0 auto; padding: 10px var(--studio-editor-padding) 180px; color: rgb(var(--gray-dark)); font-size: var(--studio-editor-font-size); line-height: var(--studio-editor-line-height); }
	:global(.crepe-host .milkdown .ProseMirror h1) { font-size: 1.7em; font-weight: 700; letter-spacing: -0.02em; line-height: 1.25; margin: 1.5em 0 0.35em; }
	:global(.crepe-host .milkdown .ProseMirror h2) { font-size: 1.35em; font-weight: 700; line-height: 1.3; margin: 1.5em 0 0.3em; }
	:global(.crepe-host .milkdown .ProseMirror h3) { font-size: 1.12em; font-weight: 650; line-height: 1.35; margin: 1.2em 0 0.25em; }
