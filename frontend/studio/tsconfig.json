{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "vendor/yiitap",
    "third_party",
    ".studio-cache",
    "src/studio/server/apps/templates"
  ],
  "compilerOptions": {
    "strictNullChecks": true,
    "paths": {
      "@studio/*": [
        "./src/studio/*"
      ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
