FROM node:22-alpine AS frontend-builder

ARG RETAIN_PDF_VERSION=""
ENV RETAIN_PDF_VERSION="${RETAIN_PDF_VERSION}"

WORKDIR /app

# Install from the monorepo lock. Running npm ci from frontend/web while a workspace
# root package.json exists makes npm resolve /app as the install root, so the
# root lock and every workspace manifest must be present in this cache layer.
COPY package.json package-lock.json ./
COPY frontend/desktop/package.json ./frontend/desktop/package.json
COPY frontend/web/package.json ./frontend/web/package.json
COPY frontend/packages/api/package.json ./frontend/packages/api/package.json
COPY frontend/packages/domain/package.json ./frontend/packages/domain/package.json
COPY frontend/packages/reader/package.json ./frontend/packages/reader/package.json
COPY contracts/package.json ./contracts/package.json
COPY frontend/packages/ui/package.json ./frontend/packages/ui/package.json
RUN npm ci --ignore-scripts

COPY frontend/packages/reader/ ./frontend/packages/reader/
COPY frontend/packages/ui/ ./frontend/packages/ui/
COPY frontend/packages/api/ ./frontend/packages/api/
COPY frontend/packages/domain/ ./frontend/packages/domain/
COPY contracts/ ./contracts/
COPY frontend/web/ ./frontend/web/
WORKDIR /app/frontend/web
RUN npm run build && \
  : > ./runtime-config.local.js

FROM nginx:1.27-alpine

# Ensures the official nginx envsubst entrypoint always replaces the template
# placeholder, even when server-side API-key injection is intentionally off.
ENV RETAINPDF_PROXY_API_KEY=""

RUN apk add --no-cache bash gettext jq

COPY --from=frontend-builder /app/frontend/web/ /usr/share/nginx/html/
COPY ops/deployment/docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY ops/deployment/docker/nginx-mjs.types.conf /etc/nginx/conf.d/mjs.types.conf
COPY ops/deployment/docker/entrypoint-web.sh /docker-entrypoint.d/99-runtime-config.sh

RUN rm -rf \
  /usr/share/nginx/html/node_modules \
  /usr/share/nginx/html/.ipynb_checkpoints \
  /usr/share/nginx/html/src/.ipynb_checkpoints && \
  rm -f \
  /usr/share/nginx/html/package.json \
  /usr/share/nginx/html/package-lock.json \
  /usr/share/nginx/html/tailwind.config.js \
  /usr/share/nginx/html/.gitignore

RUN chmod +x /docker-entrypoint.d/99-runtime-config.sh

EXPOSE 80
