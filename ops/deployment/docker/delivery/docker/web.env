# Docker 公共版前端运行时配置
# FRONT_API_BASE 通常留空，前端会自动走同源代理。
# 普通用户不需要在页面里看到或填写 API Base。
FRONT_API_BASE=

# 与 docker/auth.local.json 中某个 key 保持一致。该值只保留在
# web 容器的 NGINX 配置中，用于同源浏览器请求和原生下载鉴权。
RETAINPDF_PROXY_API_KEY=replace-with-your-backend-key

# 不要把后端 key 写入浏览器可读的 runtime-config.js。仅在不经
# RetainPDF NGINX 的特殊客户端部署中才应显式设置此兼容字段。
FRONT_X_API_KEY=

# 前端默认 OCR provider。
# 当前主线默认建议使用 paddle，也可以改成 mineru。
FRONT_OCR_PROVIDER=paddle

# 可选的 OCR / 模型默认配置。
# 如果希望最终用户在浏览器里自己填写 OCR / 模型配置，就保持为空。
FRONT_PADDLE_TOKEN=
FRONT_MINERU_TOKEN=
FRONT_MODEL_API_KEY=
FRONT_MODEL=deepseek-v4-flash
FRONT_BASE_URL=https://api.deepseek.com/v1
