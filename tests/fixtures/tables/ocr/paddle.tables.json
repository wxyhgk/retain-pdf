  "html": "<table><tr><td>Category</td><td>Feature</td><td>BabelDOC</td><td>PDFMathTrans.</td><td>Doc2X</td><td>TeX-based</td><td>Google</td><td>DeepL</td></tr><tr><td rowspan=\"2\">Accessibility</td><td>Open-source Deployment</td><td>✓</td><td>✓</td><td>✗</td><td>✓</td><td>✗</td><td>✗</td></tr><tr><td>API Integration</td><td>✓</td><td>✓</td><td>✓</td><td>✓</td><td>✓</td><td>✓</td></tr><tr><td rowspan=\"7\">Layout &amp; Visual Integrity</td><td>Multi-column Layout Preservation</td><td>✓</td><td>✓</td><td>✓</td><td>✗</td><td>✗</td><td>Partial</td></tr><tr><td>Vector Formula Translation</td><td>✓</td><td>✓</td><td>✓</td><td>✓</td><td>✗</td><td>✗</td></tr><tr><td>Dual-page Bilingual Output</td><td>✓</td><td>✓</td><td>Partial</td><td>✓</td><td>✗</td><td>✗</td></tr><tr><td>Scanned PDF (OCR Support)</td><td>✓</td><td>✓</td><td>✓</td><td>✗</td><td>✓</td><td>✓</td></tr><tr><td>Footnote Reconstruction</td><td>✓</td><td>✗</td><td>Partial</td><td>✗</td><td>✗</td><td>✗</td></tr><tr><td>Font Style Preservation</td><td>✓</td><td>Partial</td><td>✗</td><td>✓</td><td>✗</td><td>✗</td></tr><tr><td>In-Figure/Table Text Translation</td><td>✓</td><td>✗</td><td>Partial</td><td>✗</td><td>✗</td><td>Partial</td></tr><tr><td rowspan=\"4\">Semantic &amp; NLP Control</td><td>Intermediate Rep. (IR)</td><td>✓</td><td>✗</td><td>✗</td><td>✗</td><td>✗</td><td>✗</td></tr><tr><td>Cross-page Context Stitching</td><td>✓</td><td>✗</td><td>✗</td><td>✗</td><td>✗</td><td>✗</td></tr><tr><td>Auto Terminology Extraction</td><td>✓</td><td>✗</td><td>✗</td><td>✗</td><td>✗</td><td>✗</td></tr><tr><td>Dictionary (Glossary) Constraints</td><td>✓</td><td>Partial</td><td>✗</td><td>✗</td><td>✗</td><td>✓</td></tr><tr><td rowspan=\"2\">Efficiency</td><td>Batch Processing</td><td>✓</td><td>✓</td><td>✓</td><td>✓</td><td>✓</td><td>✓</td></tr><tr><td>Avg. Speed (sec/page)</td><td>1.63</td><td>1.47</td><td>1.86</td><td>1.67</td><td>0.38</td><td>1.88</td></tr></table>",
