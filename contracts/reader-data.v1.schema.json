{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retainpdf/contracts/reader-data/v1",
  "title": "Reader Read Model Contract",
  "description": "Stable Reader-facing read DTOs. Each successful HTTP response is wrapped in { code, message, data }; this schema describes data and SSE event payloads only. It deliberately exposes public API paths/URLs and never backend filesystem paths, checkpoints, workspace state, credentials, or provider request payloads. RetainPDF-specific host adapters map endpoint responses into these DTOs before supplying @retainpdf/reader ports.",
  "base_path": "/api/v1",
  "endpoints": [
    {
      "method": "GET",
      "path": "/api/v1/jobs/:job_id/files",
      "client_name": "listJobFiles",
      "transport": "json",
      "output": "JobFilesView",
      "rust_view": "JobFilesView",
      "ts_consumer": "@retainpdf/contracts/reader-data :: JobFilesView",
      "note": "任务的文件清单：output 成品、pages 译文页预览、internal 中间产物（只有管理员和单机模式才有这个字段）。取代 /artifacts 和 /artifacts-manifest。"
    },
    {
      "method": "GET",
      "path": "/api/v1/jobs/:job_id/reader/markdown",
      "client_name": "getReaderMarkdown",
      "transport": "json",
      "output": "MarkdownDocumentView",
      "rust_view": "MarkdownDocumentView",
      "ts_consumer": "@retainpdf/contracts/reader-data :: MarkdownDocumentView"
    },
    {
      "method": "GET",
      "path": "/api/v1/jobs/:job_id/reader/regions",
      "client_name": "getReaderRegions",
      "transport": "json",
      "output": "ReaderRegionsView",
      "rust_view": "ReaderRegionsView",
      "ts_consumer": "@retainpdf/contracts/reader-data :: ReaderRegionsView"
    },
    {
      "method": "GET",
      "path": "/api/v1/jobs/:job_id/reader/metadata",
      "client_name": "getReaderMetadata",
      "transport": "json",
      "output": "ReaderMetadataView",
      "rust_view": "ReaderMetadataView",
      "ts_consumer": "@retainpdf/contracts/reader-data :: ReaderMetadataView"
    },
    {
      "method": "GET",
      "path": "/api/v1/jobs/:job_id/reader/layout",
      "client_name": "getReaderLayout",
      "transport": "json",
      "output": "ReaderLayoutView",
      "rust_view": "ReaderLayoutView",
      "ts_consumer": "@retainpdf/contracts/reader-data :: ReaderLayoutView",
      "note": "rpr_fit 排版引擎排的版面清单（2026-11-28），阅读页的 HTML 页照它画、和译文 PDF 一样。没有版面不是错误：available=false 带 reason，能补排时 generate 给出原地重新渲染的请求。"
    },
    {
      "method": "GET",
      "path": "/api/v1/jobs/:job_id/reader/layout/pages/:page_idx",
      "client_name": "getReaderLayoutPage",
      "transport": "json",
      "output": "ReaderLayoutPage",
      "rust_view": "serde_json::Value（rpr_layout_v1 的一页，原样）",
      "ts_consumer": "@retainpdf/contracts/reader-data :: ReaderLayoutPage",
      "note": "一页版面，page_idx 是原文页号（从 0 起）。带弱 ETag（等于清单里这页的 etag），If-None-Match 一样回 304；没有这页 404。"
    },
    {
      "method": "GET",
      "path": "/api/v1/jobs/:job_id/reader/layout/background",
      "transport": "binary",
      "note": "版面的底图 PDF（2026-11-28）：译文 PDF 的底（去掉原字的原文页），只含清单 background.pages 里的页、按页号从小到大排；支持 Range。清单里 background 是 null 时 404。"
    },
    {
      "method": "GET",
      "path": "/api/v1/jobs/:job_id/reader/layout/fonts/:name",
      "transport": "binary",
      "note": "版面用的字体子集（font/woff2），清单 fonts[].url 指着它；只认清单里列了的。长缓存"
    },
    {
      "method": "GET",
      "path": "/api/v1/jobs/:job_id/reader/layout/math/:name",
      "transport": "binary",
      "note": "版面里公式的 MathJax SVG（image/svg+xml），name 是公式项 svg 去掉 math/ 前缀。长缓存"
    },
    {
      "method": "GET",
      "path": "/api/v1/jobs/:job_id/progress/layout",
      "client_name": "getLiveLayout",
      "transport": "json",
      "output": "LiveTranslationLayout",
      "rust_view": "LiveTranslationLayoutView",
      "ts_consumer": "@retainpdf/contracts/reader-data :: LiveTranslationLayout"
    },
    {
      "method": "GET",
      "path": "/api/v1/jobs/:job_id/progress/pages/:page",
      "client_name": "getLivePage",
      "transport": "json",
      "output": "LiveTranslationPageSnapshot",
      "rust_view": "LiveTranslationPageView",
      "ts_consumer": "@retainpdf/contracts/reader-data :: LiveTranslationPageSnapshot",
      "note": ":page 是从 0 开始的页序号（第一页是 0），和返回的 page_idx 同一个数；不是非负整数时 400。"
    },
    {
      "method": "GET",
      "path": "/api/v1/jobs/:job_id/progress/stream?after_seq=:seq",
      "transport": "sse",
      "output": "LiveTranslationCommitEvent",
      "rust_view": "LiveTranslationCommitEventView",
      "ts_consumer": "@retainpdf/contracts/reader-data :: LiveTranslationCommitEvent"
    },
    {
      "method": "GET",
      "path": "/api/v1/jobs/:job_id/files/output/*name",
      "transport": "binary",
      "rust_view": "文件本身（Content-Type 按扩展名；支持 Range、ETag）",
      "note": "取一个成品：translated.pdf、side-by-side.pdf、translated.docx、ocr.md、ocr.zip、ocr/images/…、all.zip（地址从 JobFilesView 的 output[].url 拿，不要自己拼）。直接是文件，不带信封；默认在浏览器里打开，`?download=1` 下载。没有这个文件 404。只登记传输方式（2026-11-24），没有 client_name：前端用地址（`jobOutputFilePath`）打开或下载。"
    }
  ],
  "definitions": {
    "JobFileEntryView": {
      "type": "object",
      "description": "One downloadable file of a job. url is an absolute public URL of /api/v1/jobs/:job_id/files/<group>/<name>.",
      "additionalProperties": false,
      "required": ["name", "url", "content_type", "ready", "on_demand", "size_bytes", "updated_at", "stage"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "content_type": { "type": "string" },
        "ready": { "type": "boolean", "description": "Whether the file can be fetched now. For on-demand files it means everything needed to generate it exists." },
        "on_demand": { "type": "boolean", "description": "Generated on first request, so the first fetch is slower." },
        "size_bytes": { "type": ["integer", "null"], "minimum": 0, "description": "Only files already on disk have a size." },
        "updated_at": { "type": ["string", "null"], "description": "Update time from the artifact registry; null when the registry has no entry (on-demand files not generated yet)." },
        "stage": { "type": ["string", "null"], "description": "Stage that produced the file (registry source_stage, e.g. ocr, translation, render); null when unknown." }
      }
    },
    "JobPagesView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url_template", "page_count"],
      "properties": {
        "url_template": { "type": "string", "description": "Replace {page} with a one-based page number." },
        "page_count": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "JobFilesView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "attempt", "source", "output", "pages"],
      "properties": {
        "job_id": { "type": "string" },
        "attempt": { "type": "integer", "minimum": 1, "description": "One-based durable pipeline attempt; increases after a rerun or stage retry. Same as the attempt of each manifest item." },
        "source": { "$ref": "#/definitions/JobFileEntryView", "description": "The source PDF. It is a document file: the url is /api/v1/documents/:id/files/source.pdf. When no document id is known there is no address: url is an empty string and ready is false." },
        "output": { "type": "array", "items": { "$ref": "#/definitions/JobFileEntryView" } },
        "pages": { "$ref": "#/definitions/JobPagesView" },
        "internal": {
          "type": "array",
          "description": "Intermediate artifacts. Present only for administrators (and in single-user mode); omitted otherwise.",
          "items": { "$ref": "#/definitions/JobFileEntryView" }
        }
      }
    },
    "MarkdownImageView": {
      "type": "object",
      "description": "Published Markdown image. path is document-relative and url is a public authenticated Reader resource URL.",
      "additionalProperties": false,
      "required": ["path", "url", "content_type", "size_bytes"],
      "properties": {
        "path": { "type": "string" },
        "url": { "type": "string" },
        "content_type": { "type": "string" },
        "size_bytes": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "MarkdownDocumentView": {
      "type": "object",
      "description": "Structured published Markdown for Reader/preview/AI. content_with_absolute_image_urls is a convenience projection; clients must not derive image filesystem paths.",
      "additionalProperties": false,
      "required": ["job_id", "ready", "content", "content_with_absolute_image_urls", "markdown_path", "markdown_url", "raw_path", "raw_url", "images_base_path", "images_base_url", "images"],
      "properties": {
        "job_id": { "type": "string" },
        "ready": { "type": "boolean" },
        "content": { "type": "string" },
        "content_with_absolute_image_urls": { "type": "string" },
        "markdown_path": { "type": "string" },
        "markdown_url": { "type": "string" },
        "raw_path": { "type": "string" },
        "raw_url": { "type": "string" },
        "images_base_path": { "type": "string" },
        "images_base_url": { "type": "string" },
        "images": { "type": "array", "items": { "$ref": "#/definitions/MarkdownImageView" } }
      }
    },
    "ReaderRegionBox": {
      "type": "object",
      "description": "Reader regions use a one-based page number and a [x0,y0,x1,y1] bbox in top-left-origin PDF points. text may be null for non-text/image blocks.",
      "additionalProperties": false,
      "required": ["page", "bbox", "unit", "origin", "text"],
      "properties": {
        "page": { "type": "integer", "minimum": 1, "description": "One-based page number." },
        "bbox": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" }, "description": "[x0,y0,x1,y1] in PDF points; producer guarantees an ordered finite rectangle." },
        "unit": { "type": "string", "const": "pdf_point" },
        "origin": { "type": "string", "const": "top_left" },
        "text": { "type": ["string", "null"] }
      }
    },
    "ReaderRegionItem": {
      "type": "object",
      "description": "item_id is canonicalized and joinable with other Reader projections when they describe the same document block. Empty asset collections are serialized as [] rather than omitted.",
      "additionalProperties": false,
      "required": ["item_id", "source", "translated", "markdown", "region_type", "status", "asset_ids", "asset_urls"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/definitions/ReaderRegionBox" },
        "translated": { "$ref": "#/definitions/ReaderRegionBox" },
        "markdown": { "type": ["string", "null"] },
        "region_type": { "type": "string" },
        "status": { "type": "string" },
        "asset_ids": { "type": "array", "items": { "type": "string" } },
        "asset_urls": { "type": "array", "items": { "type": "string" } },
        "reading_order": { "type": "integer", "description": "Page-local reading order. Items are emitted sorted by (source.page, reading_order), with source-only blocks interleaved." },
        "sub_type": { "type": "string", "description": "Normalized document sub_type, e.g. body, heading, title, page_number, reference_entry, figure_caption, image_body, display_formula. Vocabulary depends on the OCR provider." },
        "heading_level": { "type": "integer", "minimum": 1, "maximum": 6, "description": "Present only for title/heading blocks; 1 is the top level." },
        "continuation_group_id": { "type": "string", "minLength": 1, "description": "Shared by the blocks of one paragraph that translation joined across blocks or pages." },
        "translated_block_text": { "type": "string", "description": "Present with continuation_group_id: this block's own share of the translation, while translated.text carries the whole group." }
      }
    },
    "ReaderRegionsView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/definitions/ReaderRegionItem" } }
      }
    },
    "ReaderPageMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "width", "height"],
      "properties": {
        "page": { "type": "integer", "minimum": 1, "description": "One-based PDF page number." },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "ReaderDocumentMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_count", "pages"],
      "properties": {
        "page_count": { "type": "integer", "minimum": 0 },
        "pages": { "type": "array", "items": { "$ref": "#/definitions/ReaderPageMetadata" } }
      }
    },
    "ReaderMetadataView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "translated"],
      "properties": {
        "source": { "anyOf": [{ "$ref": "#/definitions/ReaderDocumentMetadata" }, { "type": "null" }] },
        "translated": { "anyOf": [{ "$ref": "#/definitions/ReaderDocumentMetadata" }, { "type": "null" }] }
      }
    },
    "ReaderLayoutPageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "width", "height", "etag", "blocks", "url"],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "原文页号，从 0 起"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "etag": {
          "type": "string",
          "description": "这页版面的指纹，取这页时的 ETag 就是它"
        },
        "blocks": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string"
        }
      }
    },
    "ReaderLayoutBackground": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "pages"],
      "properties": {
        "url": {"type": "string", "description": "PDF，支持 Range"},
        "pages": {"type": "array", "items": {"type": "integer", "minimum": 0}, "description": "底图第 n 页是原文第 pages[n] 页（从 0 起）"}
      }
    },
    "ReaderLayoutFont": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "family", "weight", "url"],
      "properties": {
        "key": {
          "type": "string",
          "description": "版面里字簇的 font 就是它"
        },
        "family": {
          "type": "string"
        },
        "weight": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        }
      },
      "description": "画字用的字体：和引擎画 PDF 用的同一份文件，只留这本书用到的字、转 woff2。主字体在前（前端按这个顺序当字体栈）。url 带 ?v=，重新渲染就换，可长缓存。后端没装 fontTools 时 fonts 是空数组"
    },
    "ReaderLayoutGenerate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "url", "body"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["POST"]
        },
        "url": {
          "type": "string"
        },
        "body": {
          "type": "object",
          "description": "照原样发：retry-stage 的请求体（stage=render、create_new_job=false，原地重新渲染这个任务；任务原来不是 rpr_fit 路线时还带 overrides.render.engine=rpr_fit）"
        }
      }
    },
    "ReaderLayoutView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "reason", "schema", "engine_version", "engine_commit", "page_count", "pages", "background", "fonts", "generate"],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["no_translated_pdf", "not_engine_route", "unsupported_render", "merged_reading", "not_kept"]
            },
            {
              "type": "null"
            }
          ],
          "description": "没有版面的原因：no_translated_pdf 还没有译文 PDF；not_engine_route 这次不是 rpr_fit 排的（Typst）；unsupported_render 引擎排不了的设置（双栏对照、字体不是思源宋体）；merged_reading 合并阅读的虚拟任务；not_kept 引擎排的但版面没留下（2026-11-28 以前的任务、或回退了 Typst）。有版面时 null。以后可能加值。"
        },
        "schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "版面格式，现在是 rpr_layout_v1"
        },
        "engine_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "engine_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "page_count": {
          "type": "integer",
          "minimum": 0
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReaderLayoutPageEntry"
          }
        },
        "background": {
          "anyOf": [{"$ref": "#/definitions/ReaderLayoutBackground"}, {"type": "null"}],
          "description": "底图：译文 PDF 的底（去掉原字的原文页）。渲染源就是原件（扫描件）时 null，用原文页做底"
        },
        "fonts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReaderLayoutFont"
          }
        },
        "generate": {
          "anyOf": [
            {
              "$ref": "#/definitions/ReaderLayoutGenerate"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ReaderLayoutCover": {
      "type": "object",
      "required": ["block", "rect", "fill"],
      "properties": {
        "block": {
          "type": "string",
          "description": "块 id，和 /reader/regions 的 item_id 同一套"
        },
        "rect": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x0, y0, x1, y1]，pt，原点在页左上、y 向下"
        },
        "fill": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "RGB，各分量 0–1"
        }
      }
    },
    "ReaderLayoutItem": {
      "type": "object",
      "required": ["x"],
      "properties": {
        "x": {
          "type": "number"
        },
        "t": {
          "type": "string",
          "description": "一个字簇，画在 x、行的基线上"
        },
        "mode": {
          "type": "string",
          "enum": ["dflt"],
          "description": "只有标点、数字的一段，按西文整形"
        },
        "tex": {
          "type": "string",
          "description": "公式的 LaTeX（有 tex 就是公式，没有 t）"
        },
        "display": {
          "type": "boolean"
        },
        "w": {
          "type": "number",
          "description": "公式盒宽，按字号的 em"
        },
        "h": {
          "type": "number",
          "description": "基线以上高，em"
        },
        "d": {
          "type": "number",
          "description": "基线以下深，em"
        },
        "font": {
          "type": "string",
          "description": "字簇用哪个字体画：清单 fonts[].key（2026-11-28 起的引擎写；mode \"dflt\" 的段、缺字时的后备字体都写明）"
        },
        "svg": {
          "type": "string",
          "description": "公式的 MathJax SVG，形如 math/<16 位十六进制>.svg；取 /api/v1/jobs/:job_id/reader/layout/<svg>（2026-11-28 起的引擎写）。颜色是 currentColor"
        }
      },
      "description": "字簇 {x, t, mode?, font?} 或公式 {x, tex, display, w, h, d, svg?}。以后可能再加字段。"
    },
    "ReaderLayoutLine": {
      "type": "object",
      "required": ["text", "x", "baseline", "width", "justified", "items"],
      "properties": {
        "text": {
          "type": "string",
          "description": "只给读和搜（公式写成 $...$），画的是 items"
        },
        "x": {
          "type": "number"
        },
        "baseline": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "justified": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReaderLayoutItem"
          }
        }
      }
    },
    "ReaderLayoutBlock": {
      "type": "object",
      "required": ["id", "fontSize", "weight", "color", "lines"],
      "properties": {
        "id": {
          "type": "string",
          "description": "块 id，和 /reader/regions 的 item_id 同一套；跨页、跨栏续段每一截各一块"
        },
        "fontSize": {
          "type": "number"
        },
        "weight": {
          "type": "string",
          "enum": ["regular", "bold"]
        },
        "color": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "RGB，各分量 0–1"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReaderLayoutLine"
          }
        }
      }
    },
    "ReaderLayoutPage": {
      "type": "object",
      "required": ["index", "width", "height", "covers", "blocks"],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "原文页号，从 0 起"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "covers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReaderLayoutCover"
          },
          "description": "先画：盖掉原文的块（填色是估的原页底色）"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReaderLayoutBlock"
          }
        }
      },
      "description": "rpr_layout_v1 的一页（引擎 src/output/pdf/layout.js），原样返回。坐标单位 pt，原点在页左上、y 向下。以后只加字段。"
    },
    "LiveTranslationTypography": {
      "type": "object",
      "description": "Optional renderer-authored typography plan. All dimensional values are PDF points except leading_em.",
      "additionalProperties": false,
      "required": ["font_family", "font_size_pt", "leading_em", "font_weight", "text_align", "padding_top_pt", "padding_right_pt", "padding_bottom_pt", "padding_left_pt", "fit_min_font_size_pt", "fit_max_font_size_pt"],
      "properties": {
        "font_family": { "type": "string" },
        "font_size_pt": { "type": "number", "exclusiveMinimum": 0 },
        "leading_em": { "type": "number", "exclusiveMinimum": 0 },
        "font_weight": { "type": "integer", "minimum": 1 },
        "text_align": { "type": "string" },
        "padding_top_pt": { "type": "number", "minimum": 0 },
        "padding_right_pt": { "type": "number", "minimum": 0 },
        "padding_bottom_pt": { "type": "number", "minimum": 0 },
        "padding_left_pt": { "type": "number", "minimum": 0 },
        "fit_min_font_size_pt": { "type": "number", "exclusiveMinimum": 0 },
        "fit_max_font_size_pt": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "LiveTranslationLayoutBlock": {
      "type": "object",
      "description": "page_idx is supplied by the enclosing page and is zero-based. item_id is canonicalized for joins with page snapshots and Reader regions.",
      "additionalProperties": false,
      "required": ["item_id", "bbox", "source_text", "kind"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "bbox": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" }, "description": "[x0,y0,x1,y1] in top-left-origin PDF points." },
        "source_text": { "type": "string" },
        "kind": { "type": "string" },
        "typography": { "$ref": "#/definitions/LiveTranslationTypography" }
      }
    },
    "LiveTranslationLayoutPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_idx", "width", "height", "blocks"],
      "properties": {
        "page_idx": { "type": "integer", "minimum": 0, "description": "Zero-based page index." },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "blocks": { "type": "array", "items": { "$ref": "#/definitions/LiveTranslationLayoutBlock" } }
      }
    },
    "LiveTranslationLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pages"],
      "properties": {
        "pages": { "type": "array", "items": { "$ref": "#/definitions/LiveTranslationLayoutPage" } }
      }
    },
    "LiveTranslationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "translated_text", "status"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "translated_text": { "type": "string", "description": "Durably committed text; LaTeX delimiters are preserved." },
        "status": { "type": "string" }
      }
    },
    "LiveTranslationPageSnapshot": {
      "type": "object",
      "description": "A durable, hash-matched page snapshot. Do not replace a newer attempt/generation/page_hash with an older event or mutable working file.",
      "additionalProperties": false,
      "required": ["attempt", "generation", "page_idx", "page_hash", "items"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 0 },
        "generation": { "type": "integer", "minimum": 0 },
        "page_idx": { "type": "integer", "minimum": 0, "description": "Zero-based page index." },
        "page_hash": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
        "items": { "type": "array", "items": { "$ref": "#/definitions/LiveTranslationItem" } }
      }
    },
    "LiveTranslationCommitEvent": {
      "type": "object",
      "description": "SSE event data for event: translation_units_committed. It is a refresh hint: reconnect using the greater of after_seq and Last-Event-ID, then refetch the authoritative page snapshot.",
      "additionalProperties": false,
      "required": ["event", "seq", "attempt", "generation", "page_idx", "page_hash", "changed_item_ids"],
      "properties": {
        "event": { "type": "string", "const": "translation_units_committed" },
        "seq": { "type": "integer", "minimum": 0, "description": "Authoritative per-job database sequence and SSE id." },
        "attempt": { "type": "integer", "minimum": 0 },
        "generation": { "type": "integer", "minimum": 0 },
        "page_idx": { "type": "integer", "minimum": 0, "description": "Zero-based page index." },
        "page_hash": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
        "changed_item_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
