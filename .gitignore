# macOS
.DS_Store

# 第三方资料/参考实现的落脚处。解压出来动辄几十万文件、还带 node_modules，
# 不进版本库。
research/

# 子 agent 的临时 git worktree。注意只忽略这一层——`.claude/` 下的 skills、
# launch.json 都是跟踪的。worktree 正常跑完会自己清掉，但进程被打断就会残留，
# 而它是一整个仓库副本，误 `git add -A` 一次就炸。
.claude/worktrees/

# Python 虚拟环境。**不要提交它**，哪怕是个符号链接 ——
# 曾经有一个 `backend/.venv -> /Users/<某人>/Code/retain-pdf/backend/.venv` 被提交进来，
# 别人 clone 下来是悬空链接，跑 uv sync 还会顺着它往仓库外写。
# worktree 要共用主 checkout 的环境，用 UV_PROJECT_ENVIRONMENT（见 ops/development/dev_stack.py）。
#
# 两条都要：`.venv/` 只匹配目录，而**符号链接在 git 眼里不是目录** —— 被提交进来的
# 那一个正是符号链接，只写带斜杠的那条它照样是 untracked 可见状态。
.venv
.venv/

# 本地测试用的 API 配置（含明文 key），绝不进仓库
.env.local
.env.*.local

# rpr 排版引擎的复制品（backend/rendering-engine/sync.sh）：上面的 data/、output/ 规则会误伤引擎源码。
!backend/rendering-engine/engine/data/
!backend/rendering-engine/engine/src/output/
