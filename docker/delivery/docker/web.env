# Cấu hình runtime frontend cho phiên bản Docker công cộng
# FRONT_API_BASE thường để trống, frontend sẽ tự động sử dụng proxy cùng nguồn.
# Người dùng thông thường không cần nhìn thấy hoặc điền API Base trong trang.
FRONT_API_BASE=

# Phải giữ khớp với một trong các backend key trong docker/auth.local.json.
# Frontend sẽ tự động đính kèm backend key xác thực này.
FRONT_X_API_KEY=replace-with-your-backend-key

# OCR provider mặc định của frontend.
# Dòng chính hiện tại khuyến nghị sử dụng paddle, cũng có thể đổi thành mineru.
FRONT_OCR_PROVIDER=paddle

# Cấu hình mặc định tùy chọn cho OCR / mô hình.
# Nếu muốn người dùng cuối tự điền cấu hình OCR / mô hình trong trình duyệt, hãy để trống.
FRONT_PADDLE_TOKEN=
FRONT_MINERU_TOKEN=
FRONT_MODEL_API_KEY=
FRONT_MODEL=deepseek-v4-flash
FRONT_BASE_URL=https://api.deepseek.com/v1
