# RetainPDF 本地部署配置模板
# 复制为 run.env 后填写：cp run.env.example run.env
# 注意：run.env 含密钥，已被 .gitignore 忽略，请勿提交。

# 后端鉴权 key（前端与后端共用；请改成随机值，别用示例值）
BACKEND_KEY=change-me-backend-key

# OCR provider：paddle | mineru
OCR_PROVIDER=paddle
MINERU_TOKEN=
PADDLE_TOKEN=

# 下游 LLM（OpenAI 兼容，例如 DeepSeek）
MODEL_API_KEY=
MODEL=deepseek-v4-flash
BASE_URL=https://api.deepseek.com/v1

# 端口
APP_PORT=41000
SIMPLE_PORT=42000
WEB_PORT=40001

# 运行环境（按需填写；留空则脚本用默认的 python3 / typst）
# PYTHON_BIN=/path/to/python3.11
# TYPST_BIN=/path/to/typst
