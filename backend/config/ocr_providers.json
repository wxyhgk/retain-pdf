{
  "providers": {
    "mineru": {
      "rank": 0,
      "display_name": "MinerU",
      "docs_url": "https://mineru.net/apiManage/docs",
      "streams_pages": "never",
      "limits": {
        "max_pages": {"default": 600, "env": "RUST_API_MINERU_MAX_PAGES"},
        "max_file_bytes": {"default": 209715200, "env": "RUST_API_MINERU_MAX_BYTES", "inclusive": false}
      },
      "kind": "remote",
      "credential": {
        "field": "mineru_token",
        "env": "RETAIN_MINERU_API_TOKEN",
        "required_for": ["remote_url", "local_upload"]
      },
      "options": {
        "model_version": {
          "type": "string",
          "default": "vlm"
        },
        "language": {
          "type": "string",
          "default": "ch"
        },
        "disable_formula": {
          "type": "boolean",
          "default": false
        },
        "disable_table": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "paddle": {
      "rank": 1,
      "display_name": "PaddleOCR",
      "docs_url": "https://aistudio.baidu.com/account/accessToken",
      "streams_pages": "chunked_upload",
      "limits": {
        "max_pages": {"default": 999, "env": "RUST_API_PADDLE_MAX_PAGES"},
        "max_file_bytes": {"default": 104857600, "env": "RUST_API_PADDLE_MAX_BYTES", "inclusive": true}
      },
      "kind": "remote",
      "credential": {
        "field": "paddle_token",
        "env": "RETAIN_PADDLE_API_TOKEN",
        "required_for": ["remote_url", "local_upload"]
      },
      "options": {
        "transport": {
          "type": "string",
          "default": "official_http",
          "choices": ["official_http", "official_cli"]
        },
        "paddle_api_url": {
          "type": "string",
          "default": ""
        },
        "paddle_model": {
          "type": "string",
          "default": "PaddleOCR-VL-1.6",
          "aliases": {
            "paddleocr-vl": "PaddleOCR-VL-1.6",
            "paddle-ocr-vl": "PaddleOCR-VL-1.6",
            "paddleocr-vl-1.6": "PaddleOCR-VL-1.6",
            "paddle-ocr-vl-1.6": "PaddleOCR-VL-1.6",
            "paddleocr-vl-1.5": "PaddleOCR-VL-1.5",
            "paddle-ocr-vl-1.5": "PaddleOCR-VL-1.5"
          }
        }
      }
    },
    "glm_ocr": {
      "rank": 2,
      "display_name": "GLM-OCR",
      "docs_url": "https://open.bigmodel.cn/usercenter/apikeys",
      "streams_pages": "always",
      "kind": "remote_command",
      "credential": {
        "field": "credential",
        "env": "RETAIN_GLM_OCR_API_TOKEN",
        "required_for": ["local_upload"],
        "shared_with_translation_host": "open.bigmodel.cn"
      },
      "options": {}
    },
    "local": {
      "rank": 3,
      "display_name": "Local OCR",
      "streams_pages": "never",
      "kind": "local_command",
      "credential": null,
      "options": {
        "command": {
          "type": "string",
          "env": "RETAIN_LOCAL_OCR_COMMAND",
          "default": ""
        },
        "raw_provider": {
          "type": "string",
          "env": "RETAIN_OCR_RAW_PROVIDER",
          "default": "generic_flat_ocr"
        }
      }
    }
  },
  "paddle": {
    "default_model": "PaddleOCR-VL-1.6",
    "model_aliases": {
      "paddleocr-vl": "PaddleOCR-VL-1.6",
      "paddle-ocr-vl": "PaddleOCR-VL-1.6",
      "paddleocr-vl-1.6": "PaddleOCR-VL-1.6",
      "paddle-ocr-vl-1.6": "PaddleOCR-VL-1.6",
      "paddleocr-vl-1.5": "PaddleOCR-VL-1.5",
      "paddle-ocr-vl-1.5": "PaddleOCR-VL-1.5"
    }
  }
}
