{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retainpdf/contracts/translation-providers/v1",
  "title": "翻译接口（Translation Providers）",
  "description": "翻译接口相关的服务端代办（2026-11-19 起）。有两个：从翻译接口拉取模型列表，和用翻译接口的配置问一次模型（可带图片，2026-11-22）——浏览器不能直接调服务商（跨域、Key 不能发出去），后端代发，Key 用完不存、不回显。生产者：backend/packages/retainpdf-providers/src/provider_probe/models.rs（TranslationModelsRequest、TranslationModelListView、TranslationModelView）和 provider_probe/ask.rs（TranslationModelAskRequest、TranslationModelAskView），单价形状是 retainpdf-providers pricing 的 PriceView（和 token-usage.v1 的 PriceView 同形状）；Rust 侧由 backend/api/src/api_tests/provider_probes.rs 对真实接口的返回钉键集合。消费者：@retainpdf/contracts/translation-providers 生成 DTO。成功响应包在 {code, message, data} 里，本契约描述 data 部分。详细规则见 docs/core/rust_api/08-Provider 校验接口.md 第 8 节。",
  "base_path": "/api/v1",
  "endpoints": [
    {
      "method": "POST",
      "path": "/api/v1/providers/translation/models",
      "client_name": "listTranslationProviderModels",
      "transport": "json",
      "input": "TranslationModelsRequest",
      "output": "TranslationModelListView",
      "errors": { "400": "BAD_REQUEST：没有 api_key、base_url 不合规（不是 http(s)、带账号密码、多用户模式下是本机或内网地址）、字段不认识" },
      "note": "admin。都是 200，看 ok / status：服务商不支持 /models 是 unsupported（界面提示手动填）、Key 不对是 unauthorized、连不上是 unreachable。和校验 Key 同一套地址检查、超时、不跟随重定向。",
      "rust_view": "retainpdf-providers provider_probe::models :: TranslationModelListView",
      "ts_consumer": "@retainpdf/contracts/translation-providers :: TranslationModelListView"
    },
    {
      "method": "POST",
      "path": "/api/v1/providers/translation/ask",
      "client_name": "askTranslationProviderModel",
      "transport": "json",
      "input": "TranslationModelAskRequest",
      "output": "TranslationModelAskView",
      "errors": {
        "400": "BAD_REQUEST：没有 api_key / model / prompt、提示词超过 100000 字、图片超过 4 张或每张超过 4 MB、图片不是标准 base64 或类型不认、base_url 不合规、字段不认识",
        "413": "请求体超过 24 MB"
      },
      "note": "admin。服务商那边的结果都是 200，看 ok / status。按 api_protocol 换写法：openai 走 /chat/completions（image_url + data URL）、openai_responses 走 /responses（input_image）、anthropic 走 /messages（image 块）。超时 180 秒，不跟随重定向。",
      "rust_view": "retainpdf-providers provider_probe::ask :: TranslationModelAskView",
      "ts_consumer": "@retainpdf/contracts/translation-providers :: TranslationModelAskView"
    }
  ],
  "definitions": {
    "TranslationModelsRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "deny_unknown_fields。",
      "required": ["api_key"],
      "properties": {
        "api_key": { "type": "string", "description": "内联 Key，用完不存。" },
        "base_url": { "type": "string", "description": "接口地址；空时 Anthropic 用官方地址，别的用默认翻译地址。" },
        "api_protocol": { "type": "string", "description": "openai（默认，openai_responses 同）或 anthropic。" }
      }
    },
    "TranslationModelListStatus": {
      "type": "string",
      "enum": ["ok", "unsupported", "unauthorized", "invalid_input", "unreachable", "provider_error"],
      "description": "unsupported：服务商回 404/405/501，或者回的不是模型列表；unauthorized：401/403；invalid_input：Key 里有放不进请求头的字符；unreachable：连不上、超时；provider_error：别的错误、重定向、列表太大。按业务码认出欠费、额度用完、套餐不含时状态照旧（401/403 是 unauthorized，其余 provider_error），summary 换成具体原因（2026-11-23 起）。"
    },
    "PriceBasis": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "host",
        "official_list",
        null
      ],
      "description": "host：接口域名对上了这家服务商；official_list：域名对不上，按模型官方标价；查不到价为 null。"
    },
    "PriceTierView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "above_input_tokens",
        "input",
        "output",
        "cache_read",
        "cache_write"
      ],
      "properties": {
        "above_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "一次请求的输入超过这个数，整次按这一档。"
        },
        "input": {
          "type": "number"
        },
        "output": {
          "type": "number"
        },
        "cache_read": {
          "type": [
            "number",
            "null"
          ]
        },
        "cache_write": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "PriceView": {
      "type": "object",
      "additionalProperties": false,
      "description": "每百万 token 的美元单价。cache_read / cache_write 为 null 表示按输入价算。",
      "required": [
        "input",
        "output",
        "cache_read",
        "cache_write",
        "tiers",
        "peak_multiplier"
      ],
      "properties": {
        "input": {
          "type": "number"
        },
        "output": {
          "type": "number"
        },
        "cache_read": {
          "type": [
            "number",
            "null"
          ]
        },
        "cache_write": {
          "type": [
            "number",
            "null"
          ]
        },
        "tiers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PriceTierView"
          },
          "description": "门槛从低到高。"
        },
        "peak_multiplier": {
          "type": "number",
          "description": "一天里最贵的时段是标价的几倍：DeepSeek 忙时 2，别家 1。"
        }
      }
    },
    "TranslationModelView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "owned_by", "created", "kind", "price_provider", "price_basis", "price"],
      "properties": {
        "id": { "type": "string" },
        "display_name": { "type": ["string", "null"], "description": "Anthropic、Gemini 给的展示名；别家没有。" },
        "owned_by": { "type": ["string", "null"] },
        "created": { "type": ["integer", "null"], "description": "服务商给的创建时间（Unix 秒）。" },
        "kind": { "type": "string", "enum": ["chat", "other"], "description": "other：名字看得出是向量、语音、画图、审核、重排、OCR、实时、视频之类；界面默认只列 chat。" },
        "price_provider": { "type": ["string", "null"], "description": "按哪家的价（models.dev 的服务商编号）；查不到为 null。" },
        "price_basis": { "$ref": "#/definitions/PriceBasis" },
        "price": { "oneOf": [{ "$ref": "#/definitions/PriceView" }, { "type": "null" }] }
      }
    },
    "TranslationModelListView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "status", "summary", "source", "base_url", "fetched_at", "http_status", "provider_code", "provider_message", "models", "chat_models"],
      "properties": {
        "ok": { "type": "boolean" },
        "status": { "$ref": "#/definitions/TranslationModelListStatus" },
        "summary": { "type": "string", "description": "给人看的一句话。" },
        "source": { "type": "string", "enum": ["provider"] },
        "base_url": { "type": "string", "description": "实际请求的地址（规范过的）。" },
        "fetched_at": { "type": "string" },
        "http_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599, "description": "出错时服务商回的 HTTP 状态码；成功、没收到回复时为 null（2026-11-23 起）。" },
        "provider_code": { "type": ["string", "null"], "description": "服务商正文里自己的业务码（智谱 1113、OpenAI insufficient_quota、百炼 Arrearage、OpenCode 只有消息时是那句话，如 Policy budget exceeded），没有时为 null。2026-11-23 以前这里是 HTTP 状态码，现在看 http_status。" },
        "provider_message": { "type": ["string", "null"], "description": "服务商报错原文，截到 500 字符，里面的 Key 换成 [REDACTED]。" },
        "models": { "type": "array", "items": { "$ref": "#/definitions/TranslationModelView" }, "description": "按 id 排序去重，最多 2000 个；status 不是 ok 时为空。" },
        "chat_models": { "type": "integer", "minimum": 0, "description": "models 里 kind=chat 的个数。" }
      }
    },
    "AskImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_type",
        "data"
      ],
      "properties": {
        "media_type": {
          "type": "string",
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/gif"
          ]
        },
        "data": {
          "type": "string",
          "description": "图片内容，标准 base64，不带 data: 前缀；解码后最多 4 MB。"
        }
      }
    },
    "TranslationModelAskRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "deny_unknown_fields。",
      "required": [
        "api_key",
        "model",
        "prompt"
      ],
      "properties": {
        "api_key": {
          "type": "string",
          "description": "内联 Key，用完不存。"
        },
        "base_url": {
          "type": "string",
          "description": "接口地址；空时 Anthropic 用官方地址，别的用默认翻译地址。"
        },
        "api_protocol": {
          "type": "string",
          "description": "openai（默认）、openai_responses 或 anthropic。"
        },
        "model": {
          "type": "string"
        },
        "system": {
          "type": "string",
          "description": "系统提示，可空。"
        },
        "prompt": {
          "type": "string",
          "description": "用户的问题，最多 100000 字。"
        },
        "images": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/AskImage"
          }
        },
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 8192,
          "description": "回答最多多少 token，默认 1024，超过 8192 按 8192。"
        }
      }
    },
    "TranslationModelAskStatus": {
      "type": "string",
      "enum": [
        "ok",
        "unauthorized",
        "rejected",
        "rate_limited",
        "insufficient_balance",
        "quota_exceeded",
        "provider_error",
        "unreachable",
        "empty",
        "invalid_input"
      ],
      "description": "rejected：服务商拒绝了请求（常见：模型不支持看图、模型名不对）；rate_limited：限流或服务商繁忙，稍后重试；insufficient_balance：欠费、余额不足、套餐到期（2026-11-23 起，以前 429 一律 rate_limited）；quota_exceeded：用量或花费上限，等重置或调上限（2026-11-23 起）；empty：回了但没有文字（可能都用在思考上）。"
    },
    "AskUsageView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "TranslationModelAskView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "status",
        "summary",
        "base_url",
        "model",
        "protocol",
        "text",
        "usage",
        "images",
        "elapsed_ms",
        "http_status",
        "provider_code",
        "provider_message",
        "asked_at"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/definitions/TranslationModelAskStatus"
        },
        "summary": {
          "type": "string",
          "description": "给人看的一句话。"
        },
        "base_url": {
          "type": "string",
          "description": "实际请求的地址（规范过的）。"
        },
        "model": {
          "type": "string"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "openai",
            "openai_responses",
            "anthropic"
          ]
        },
        "text": {
          "type": "string",
          "description": "模型的回答；失败时是空串。"
        },
        "usage": {
          "oneOf": [
            {
              "$ref": "#/definitions/AskUsageView"
            },
            {
              "type": "null"
            }
          ]
        },
        "images": {
          "type": "integer",
          "minimum": 0,
          "description": "这次带了几张图。"
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599,
          "description": "服务商回的 HTTP 状态码；没收到回复（连不上、超时、请求没发出）时为 null（2026-11-23 起）。"
        },
        "provider_code": {
          "type": [
            "string",
            "null"
          ],
          "description": "服务商正文里自己的业务码（智谱 1113、OpenAI insufficient_quota、百炼 Arrearage……），没有时为 null。2026-11-23 以前这里是 HTTP 状态码，现在看 http_status。"
        },
        "provider_message": {
          "type": [
            "string",
            "null"
          ],
          "description": "服务商报错原文，截到 500 字符，里面的 Key 换成 [REDACTED]。"
        },
        "asked_at": {
          "type": "string"
        }
      }
    }
  }
}
