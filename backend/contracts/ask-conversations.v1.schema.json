        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "最后一次改的时间；没改过 null。"
        }
      }
    },
    "PatchAskSettingsInput": {
      "type": "object",
      "additionalProperties": false,
      "description": "给了的才改；什么都不给回现在的。",
      "properties": {
        "memory_enabled": {
          "type": "boolean"
        }
      }
    },
    "AskContextView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation",
        "memory_enabled",
        "summary",
        "summary_covers_to_seq",
        "parent",
        "messages",
        "omitted_messages",
        "memories",
        "memory_text",
        "text"
      ],
      "properties": {
        "conversation": {
          "$ref": "#/definitions/AskConversationRecord"
        },
        "memory_enabled": {
          "type": "boolean",
          "description": "「让 AI 使用记忆」开着没有；关着时 memories 是空的、memory_text 是空串。"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "description": "生效的那份压缩摘要（2026-11-26 第二期）；没压过是 null。有的话 messages 只是它之后的最近几轮，text 里也带「之前对话的摘要」一段。"
        },
        "summary_covers_to_seq": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "那份摘要替代到第几条（seq <= 它）；没压过是 null。"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/definitions/AskContextParentView"
            },
            {
              "type": "null"
            }
          ]
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AskConversationMessageRecord"
          },
          "description": "最近几轮（不分书），按 seq。"
        },
        "omitted_messages": {
          "type": "integer",
          "minimum": 0,
          "description": "更早的还有几条没带。"
        },
        "memories": {
          "$ref": "#/definitions/AskContextMemoriesView"
        },
        "memory_text": {
          "type": "string",
          "description": "记忆那段（给模型看的写法：- [编号] 日期 类别：内容），放进系统提示词；没有记忆是空串。"
        },
        "text": {
          "type": "string",
          "description": "整份拼好的文字（记忆 + 前文），给不认结构的本机 agent 放进第一问前面；什么都没有是空串。"
        }
      }
    },
    "DocumentAskMessagesView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "messages"
      ],
      "properties": {
        "document_id": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AskConversationMessageRecord"
          }
        }
      }
    },
    "ListAskMemoriesQuery": {
      "type": "object",
      "additionalProperties": false,
      "description": "不认识的参数 400。",
      "properties": {
        "scope": {
          "$ref": "#/definitions/AskMemoryScope"
        },
        "document_id": {
          "type": "string"
        },
        "q": {
          "type": "string",
          "description": "全文检索，最多 200 字。"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "superseded",
            "deleted",
            "all"
          ],
          "description": "默认 active。"
        },
        "source_conversation_id": {
          "type": "string"
        },
        "created_after": {
          "type": "string",
          "description": "只要这个时间之后记的（RFC 3339；前端每答完一轮补画「已记住」用）。"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "description": "默认 100。"
        }
      }
    },
    "AskMemoryListView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memories"
      ],
      "properties": {
        "memories": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AskMemoryRecord"
          }
        }
      }
    },
    "CreateAskMemoryInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "text"
      ],
      "properties": {
        "scope": {
          "$ref": "#/definitions/AskMemoryScope"
        },
        "document_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "anyOf": [
            {
              "$ref": "#/definitions/AskMemoryCategory"
            },
            {
              "type": "null"
            }
          ],
          "description": "默认 other。"
        },
        "text": {
          "type": "string",
          "description": "1–500 字（去掉首尾空白）。"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/definitions/AskMemoryOrigin"
            },
            {
              "type": "null"
            }
          ],
          "description": "默认 user。"
        },
        "agent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_conversation_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "不在库里（删了）当没给。"
        },
        "source_message_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "不在库里当没给。"
        },
        "source_job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "replaces": {
          "type": [
            "string",
            "null"
          ],
          "description": "替代哪一条（旧的标 superseded）。"
        }
      }
    },
    "AskMemoryCreatedView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory",
        "created",
        "replaced"
      ],
      "properties": {
        "memory": {
          "$ref": "#/definitions/AskMemoryRecord"
        },
        "created": {
          "type": "boolean",
          "description": "false：已经有一模一样的一条，回的是那条。"
        },
        "replaced": {
          "type": [
            "string",
            "null"
          ],
          "description": "被替代的那条的编号。"
        }
      }
    },
    "PatchAskMemoryInput": {
      "type": "object",
      "additionalProperties": false,
      "description": "给了的才改。",
      "properties": {
        "text": {
          "type": "string"
        },
        "category": {
          "$ref": "#/definitions/AskMemoryCategory"
        }
      }
    },
    "AcpMemoryNotice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "text",
        "category",
        "document_id",
        "created",
        "replaced"
      ],
      "description": "不是接口返回：自带 agent 的 remember 成功时，ACP tool_call_update（status completed）的 _meta.retainpdf.memory。前端把这张工具卡片画成「已记住：……（撤销）」。",
      "properties": {
        "id": {
          "type": "string",
          "description": "记忆编号（mem-…），撤销调 DELETE /ai/memories/{id}。"
        },
        "scope": {
          "$ref": "#/definitions/AskMemoryScope"
        },
        "text": {
          "type": "string"
        },
        "category": {
          "$ref": "#/definitions/AskMemoryCategory"
        },
        "document_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "created": {
          "type": "boolean",
          "description": "false：已经有一模一样的一条（没有新记）。"
        },
        "replaced": {
          "type": [
            "string",
            "null"
          ],
          "description": "被替代的那条；撤销时它会恢复。"
        }
      }
    }
  }
}
