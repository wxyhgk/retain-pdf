        }
       ]
      },
      {
       "bbox": [
        72,
        457,
        540,
        469
       ],
       "spans": [
        {
         "type": "text",
         "content": "The smallest spacer yields the fastest perpendicular transport and the weakest confinement.",
         "bbox": [
