     {
      "block_label": "header",
      "block_content": "Distributed Fibre Sensing of Soil Moisture",
      "block_bbox": [
       100,
       56,
       1124,
       92
      ],
      "block_id": 0,
      "block_order": null,
      "group_id": 0,
      "global_block_id": 6,
      "global_group_id": 1006,
      "block_polygon_points": [
