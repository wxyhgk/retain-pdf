    85,
    890,
    135
   ]
  },
  {
   "type": "paragraph",
   "content": {
    "paragraph_content": [
     {
      "type": "text",
      "content": "Intracellular calcium signalling regulates metabolism, yet the contribution of mitochondria to buffering remains debated. Here we measure the decay constant "
     },
     {
      "type": "equation_inline",
      "content": "\\tau"
     },
     {
      "type": "text",
      "content": " of cytosolic transients in hepatocytes treated with the uncoupler FCCP."
     }
    ]
   },
   "bbox": [
    110,
    150,
    890,
    235
   ]
  },
  {
   "type": "title",
   "content": {
    "title_content": [
     {
      "type": "text",
      "content": "1. Methods"
     }
    ],
    "level": 2
   },
   "bbox": [
    110,
    262,
    520,
    292
   ]
  },
  {
   "type": "paragraph",
   "content": {
    "paragraph_content": [
     {
      "type": "text",
      "content": "Cells were loaded with 2 "
     },
     {
      "type": "equation_inline",
      "content": "\\mu\\mathrm{M}"
     },
     {
      "type": "text",
      "content": " Fluo-4 and imaged at 37 °C. The free calcium concentration was estimated from "
     },
     {
      "type": "equation_inline",
      "content": "[\\mathrm{Ca}^{2+}] = K_d \\frac{F - F_{min}}{F_{max} - F}"
     },
     {
      "type": "text",
      "content": " with "
     },
     {
      "type": "equation_inline",
      "content": "K_d = 345\\,\\mathrm{nM}"
     },
     {
      "type": "text",
      "content": ", following standard calibration."
     }
    ]
   },
   "bbox": [
    110,
    305,
    890,
    400
   ]
  },
  {
   "type": "equation_interline",
   "content": {
    "math_content": "\\tau = \\frac{\\Delta [\\mathrm{Ca}^{2+}]}{J_{\\mathrm{mito}} + J_{\\mathrm{SERCA}}}",
    "math_type": "latex",
    "image_source": {
     "path": "images/eq_0001.jpg"
    }
   },
   "bbox": [
    300,
    418,
    700,
    478
   ]
  },
  {
   "type": "paragraph",
   "content": {
    "paragraph_content": [
     {
      "type": "text",
      "content": "where "
     },
     {
      "type": "equation_inline",
      "content": "J_{\\mathrm{mito}}"
     },
     {
      "type": "text",
      "content": " and "
     },
     {
      "type": "equation_inline",
      "content": "J_{\\mathrm{SERCA}}"
     },
     {
      "type": "text",
      "content": " denote the mitochondrial and ER uptake fluxes, respectively."
     }
    ]
   },
   "bbox": [
    110,
    492,
    890,
    560
   ]
  },
